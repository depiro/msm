INSERT INTO `wp_postmeta` VALUES (6002,1066,'_presentacion_del_tramite','La creación de un usuario para utilizar la aplicación de estacionamiento medido, le permite al vecino pagar la tarifa desde su teléfono, sin necesidad de tener que acercarse a un punto de venta.');
INSERT INTO `wp_postmeta` VALUES (6003,1066,'_requisitos','Para generar el usuario, es necesario descargar la Aplicación SEM San Miguel para Android o SEM Mobile para iOS. También se puede crear desde  <a href=\"/sem-2/\">Estacionamiento Medido</a>');
