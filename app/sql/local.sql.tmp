INSERT INTO `wp_postmeta` VALUES (7287,1138,'_presentacion_del_tramite','Este trámite es para regularizar todas y cada uno de las ventas que se realicen en la vía pública.\n<ol>\n 	<li>Diríjase a la Dirección General de Habilitaciones para obtener el formulario de inscripción o renovación del permiso de venta ambulante.</li>\n 	<li>Complete el formulario y adjunte la documentación requerida (detallada más adelante).</li>\n 	<li>Una vez presentada la documentación, se genera un expediente, que será caratulado y derivado nuevamente a Habilitaciones para la emisión del recibo de pago.</li>\n 	<li>Realice el pago correspondiente.</li>\n 	<li>Una vez aprobado, se emite el <strong>Certificado de Permiso Ambulante</strong>.</li>\n</ol>');
INSERT INTO `wp_postmeta` VALUES (7288,1138,'_requisitos','Toda persona física mayor de 18 años que resida en el Partido de San Miguel puede realizar este tramite.\n\n<strong>Para Inscripción:</strong>\n<ul>\n 	<li>Declaración Jurada de Venta Ambulante (trámite presencial en la oficina).</li>\n 	<li>Fotocopia del DNI del titular.</li>\n 	<li>Una foto 4x4.</li>\n</ul>\n<strong>Para Renovación:</strong>\n<ul>\n 	<li>Declaración Jurada de Venta Ambulante (trámite presencial en la oficina).</li>\n 	<li>Último comprobante de pago de venta ambulante.</li>\n 	<li>Una foto 4x4.</li>\n 	<li>En caso de poseer discapacidad, deberá presentar el <strong>Certificado de Discapacidad</strong> para quedar eximido según lo establecido en el Artículo N.º 25.</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (7289,1138,'_duracion_del_tramite','48 horas hábiles.');
INSERT INTO `wp_postmeta` VALUES (7290,1138,'_vigencia_del_documento_obtenido','El permiso de venta ambulante tiene una vigencia de un año a partir de la fecha de inscripción o renovación. Si el titular no realiza el pago de dos semestres consecutivos y no renueva el permiso, este perderá automáticamente su validez.');
INSERT INTO `wp_postmeta` VALUES (7291,1138,'_respaldo_legal','Ordenanza 15/14');
INSERT INTO `wp_postmeta` VALUES (7292,1138,'_observaciones','Una vez presentada la documentación se genera el expediente y es derivado a Mesa de Entrada para ser caratulado, luego de esto se gira nuevamente el Expediente a Habilitaciones para la generación del recibo para pagar.\nUna vez aprobado, se genera el Certificado de Permiso Ambulante correspondiente.\nEn caso de requerir asesoramiento puede contactarse con el número telefónico de “Ayuda en Línea”: 11 2897-1924.');
INSERT INTO `wp_postmeta` VALUES (7293,1138,'_lugar_de_atencion','Sarmiento 1686');
INSERT INTO `wp_postmeta` VALUES (7294,1138,'_horarios_de_atencion','Lunes a viernes de 8 a 14 hs.');
