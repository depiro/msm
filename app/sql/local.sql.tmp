INSERT INTO `wp_postmeta` VALUES (5577,1045,'_presentacion_del_tramite','A través de este trámite se puede realizar el cambio de destino, siempre que las superficies de los destinos no superen los 30m2 y no modifiquen su condición de reglamentariedad.');
INSERT INTO `wp_postmeta` VALUES (5578,1045,'_requisitos','<ol>\n 	<li>Fotocopia de la escritura o boleto de compra venta.</li>\n 	<li>Plano del plano de aprobado original</li>\n 	<li>Copia del plano de obra original</li>\n 	<li>Fotocopia de último recibo de impuesto municipal.</li>\n 	<li><a href=\"/wp-content/uploads/2025/02/Solicitud-de-cambio-de-destino.docx\">Formulario de Cambio de Destino</a></li>\n 	<li>Comprobante de pago de Sellado correspondiente.</li>\n</ol>');
INSERT INTO `wp_postmeta` VALUES (5579,1045,'_duracion_del_tramite','De 2 a 5 días hábiles desde el momento que el expediente llega a la Dirección de Obras Particulares.');
INSERT INTO `wp_postmeta` VALUES (5580,1045,'_vigencia_del_documento_obtenido','Permanente');
INSERT INTO `wp_postmeta` VALUES (5581,1045,'_respaldo_legal','<a href=\"/boletin-oficial/\">Ordenanza Tarifaria y Fiscal Vigente</a>');
INSERT INTO `wp_postmeta` VALUES (5582,1045,'_observaciones','Los cambios de destino no pueden superar los 30m2, de ser así debe iniciarse como expediente de obra.\n\n<strong>Descripción del trámite:</strong>\n<ol>\n 	<li>Dirigirse a la Dirección de Obras Particulares con el plano de obra original, y verificar la viabilidad del cambio de destino que se desea realizar.</li>\n 	<li>Completar la solicitud de Cambio de destino. El personal de Obras Particulares visará la documentación presentada e imprimirá una boleta para el pago del sellado correspondiente.</li>\n 	<li>Dirigirse a las cajas (ubicadas en la planta baja del Palacio Municipal) y realizar el pago del sellado.</li>\n 	<li>Dirigirse con toda la documentación a Mesa De Entrada, donde se inicia el expediente. El mismo es girado internamente a la Subsecretaria de Obras Particulares y Desarrollo Urbano, y desde allí a la Dirección de Obras Particulares, donde se realizará el cambio de destino solicitado.</li>\n 	<li>Retornar a la Dirección de Obras Particulares para retirar el plano de obra cambio de destino.</li>\n</ol>\n<strong>Documento que se obtiene:</strong>\n\nPlano de obra de Cambio de Destino.\n\n<strong>¿Quién lo puede realizar?:</strong>\n\nPropietario, persona y/o gestor autorizado por el mismo.\n\n<strong>¿Cómo recibo el resultado del trámite?:</strong>\n\nSe recibe Plano de obra con el cambio de destino solicitado, que se retira por la Dirección de Obras Particulares.\n\n<strong>Costo del trámite:</strong>\n\n<a href=\"/boletin-oficial/\">Ordenanza Tarifaria.</a>');
INSERT INTO `wp_postmeta` VALUES (5583,1045,'_lugar_de_atencion','Dirección de Obras Particulares, Belgrano 1342, 3º piso.');
INSERT INTO `wp_postmeta` VALUES (5584,1045,'_horarios_de_atencion','Lunes a viernes de 08 a 14hs');
INSERT INTO `wp_postmeta` VALUES (5585,1045,'_edit_last','1');
