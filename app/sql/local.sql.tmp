INSERT INTO `wp_postmeta` VALUES (6802,1101,'_presentacion_del_tramite','Tramite para adherir tus Tasas de Servicios Municipales o de rodados al pago por débito automático');
INSERT INTO `wp_postmeta` VALUES (6803,1101,'_requisitos','<strong>TISH:</strong>\n\nContar con todas las declaraciones juradas de TISH de las cuotas adeudas realizadas en el portal de autogestión. En caso de asistir a la Municipalidad deberá presentar DNI  (en el caso de no ser el titular concurrir con autorización o poder, y fotocopia del DNI del titular y del responsable de pago).\n\n<strong>TSM:</strong>\n\nEn caso de asistir a la Municipalidad presentar fotocopia de escritura o boleto de compra/venta  debidamente sellado y fotocopia de DNI del titular en caso de gestor (matrícula y dni).\n\nAbonar 1º cuota en el mismo momento del trámite.\n\n<strong>RODADOS:</strong>\n\nFotocopia de Escritura o boleto de compra/venta debidamente sellado.\nFotocopia de DNI del titular - en caso de gestor, matrícula y dni\nAbonar 1º cuota en el mismo momento del trámite.');
INSERT INTO `wp_postmeta` VALUES (6804,1101,'_duracion_del_tramite','En el Portal de Pagos 10 minutos, presencial aproximadamente 1 hora.');
INSERT INTO `wp_postmeta` VALUES (6805,1101,'_vigencia_del_documento_obtenido','');
INSERT INTO `wp_postmeta` VALUES (6806,1101,'_respaldo_legal','<a href=\"//www-dev.msm.gov.ar/boletin-oficial/\">Ordenanza Tarifaria y Fiscal</a>');
INSERT INTO `wp_postmeta` VALUES (6807,1101,'_observaciones','<strong>Costo del trámite:</strong> Gratuito\n\n<strong>Descripción del trámite (Pasos a seguir):</strong>\n<ol>\n 	<li>Dirigirse al sector de TSM con la documentación solicitada en el item Requisitos.</li>\n 	<li>Seleccionar el Plan de Pagos entre las opciones ofrecidas.</li>\n 	<li>Firmar convenio luego que el empleado haya cargado los datos en el sistema.</li>\n 	<li>Dirigirse a las cajas para consolidad el convenio abonando la 1º cuota del mismo.</li>\n</ol>\nSeleccionar el Plan de Pagos entre las opciones ofrecidas. Firmar convenio luego que el empleado haya cargado los datos en el sistema. Dirigirse a las cajas para consolidad el convenio abonando la 1º cuota del mismo.');
INSERT INTO `wp_postmeta` VALUES (6808,1101,'_lugar_de_atencion','Desde el Portal de Pagos ingresando <a href=\"https://autogestion.msm.gov.ar/\"><strong>aquí</strong></a><strong> </strong>con el usuario y clave web.');
INSERT INTO `wp_postmeta` VALUES (6809,1101,'_horarios_de_atencion','24 hs.');
