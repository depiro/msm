INSERT INTO `wp_postmeta` VALUES (6202,1077,'_presentacion_del_tramite','<p class=\"bg-secretaria border-table\">Si se necesita realizar extracción y/o talas sobre el arbolado o arbustos con porte arbóreo interno, en Espacios Ecológicamente Protegidos o en los casos que se describen a continuación:</p>\n\n<ul>\n 	<li>Permiso de Obra nueva o existente.</li>\n 	<li>Permiso de Demolición</li>\n 	<li>Permiso de remoción de suelo</li>\n 	<li>Materialización del suelo</li>\n 	<li>Tramitación del plano de Mensura</li>\n 	<li>Consulta Técnica de Conformidad</li>\n</ul>\nSe debe obtener previamente la autorización correspondiente por parte de la autoridad ambiental municipal.');
INSERT INTO `wp_postmeta` VALUES (6203,1077,'_requisitos','<p class=\"bg-secretaria border-table\">Si se necesita realizar extracción y/o talas sobre el arbolado o arbustos con porte arbóreo interno, en Espacios Ecológicamente Protegidos o en los casos que se describen a continuación:</p>\n\n<ul>\n 	<li>Permiso de Obra nueva o existente.</li>\n 	<li>Permiso de Demolición</li>\n 	<li>Permiso de remoción de suelo</li>\n 	<li>Materialización del suelo</li>\n 	<li>Tramitación del plano de Mensura</li>\n 	<li>Consulta Técnica de Conformidad</li>\n</ul>\nSe debe obtener previamente la autorización correspondiente por parte de la autoridad ambiental municipal.');
INSERT INTO `wp_postmeta` VALUES (6204,1077,'_duracion_del_tramite','Una vez presentada toda la documentación personalmente en la Dependencia Municipal que se haya indicado, la misma tendrá una semana para dar intervención al área ambiental con competencia, adicionando una semana más como máximo para emitir la conformidad y el visado final del Plano de Relevamiento Arbóreo o Informe Técnico de Arbolado.');
INSERT INTO `wp_postmeta` VALUES (6205,1077,'_vigencia_del_documento_obtenido','Si no surgen cambios en el proyecto, tiene una vigencia hasta 365 días');
INSERT INTO `wp_postmeta` VALUES (6206,1077,'_respaldo_legal','Ordenanza 41/17');
INSERT INTO `wp_postmeta` VALUES (6207,1077,'_observaciones','<strong>Descripción del trámite:</strong>\n<ol>\n 	<li>El profesional actuante deberá estar matriculado en el Colegio Profesional de la Pcia. de Bs. As. inscripto en el Registro Municipal de Profesionales Ambientales.</li>\n 	<li>Contar con los Requisitos para realizar el Relevamiento Arbóreo, según el tipo de espacio y proyecto.</li>\n 	<li>Realizar un Plano de Relevamiento Arbóreo y/o Informe Técnico según corresponda, visado por el colegio profesional.</li>\n</ol>\n<strong>Documento que se obtiene:</strong>\n\nNota de conformidad al proyecto con los condicionantes a cumplir y el visado final del Plano de Arbolado.\n\n<strong>¿Quién lo puede realizar?:</strong>\n\nTitular de las parcelas involucradas o profesional encargado de la tramitación de Planos de Mensura, Planos de Obra, Permiso de Demolición o Excavación, o Consulta Técnica de Conformidad, ubicados en Espacios Ecológicamente Protegidos o impliquen proyectos de emprendimientos comerciales, industriales o de conjunto de viviendas.\n\n<strong>Costo del trámite:</strong>\n\nSin costo.');
INSERT INTO `wp_postmeta` VALUES (6208,1077,'_lugar_de_atencion','Debe solicitarse turno en <a href=\"blank\">evaluación.ambiental@msm.gov.ar</a> / tel. 60917100 interno 6133');
INSERT INTO `wp_postmeta` VALUES (6209,1077,'_horarios_de_atencion','Lunes a viernes de 9hs a 16hs');
