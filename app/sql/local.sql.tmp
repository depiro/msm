INSERT INTO `wp_postmeta` VALUES (6432,1086,'_observaciones','<strong>Descripción del trámite:</strong>\n<ol>\n 	<li>Ingresar a <a href=\"https://ventanillaunica.msm.gov.ar/PortalTramites\">Portal de Tramites</a></li>\n 	<li>Dirigirse a la solapa que dice “Recursos Territoriales”.</li>\n 	<li>Seleccionar “Planchetas Municipales”.</li>\n 	<li>Seleccionar el Número de Manzana (circunscripción – sección – nro de manzana).</li>\n 	<li>Seleccionar “Aplicar”.</li>\n 	<li>(En caso de no conocer Número de Manzana, podrá ingresar en el buscador la dirección y podrá ver el nro que le corresponde).</li>\n</ol>\n<strong>Documento que se obtiene:</strong>\n\nPlancheta digital o en mano.\n\n<strong>¿Quién lo puede realizar?:</strong>\n\nContribuyente o profesionales en general.\n\n<strong>Documento que se obtiene:</strong>\n\nPlancheta digital o en mano.\n\n<strong>¿Cómo recibo el resultado del trámite?:</strong>\n\nEl titular recibirá plancheta en mano o se puede descargar por la página.\n\n<strong>Costo del trámite:</strong>\n\n<a href=\"/boletin-oficial/\">Según tarifaria y fiscal</a>\n\n&nbsp;');
