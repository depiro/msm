INSERT INTO `wp_postmeta` VALUES (4904,1011,'_respaldo_legal','');
INSERT INTO `wp_postmeta` VALUES (4905,1011,'_observaciones','<strong>Documento que se obtiene:</strong>\n\nComprobante de autorización de utilización del Predio.\n\n<strong>Descripción del trámite:</strong>\n<ul>\n 	<li>Descargar el <a href=\"/wp-content/uploads/2025/02/SOLICITUD-actividades-campamentiles-1.pdf\">formulario adjunto</a>, o solicitar una copia en la oficina de la Subsecretaría de Deportes.</li>\n 	<li>Completarlo y presentarlo en la Subsecretaría de Deportes.</li>\n 	<li>Verificar la aprobación de la fecha solicitada.</li>\n 	<li>En caso de tratarse de una salida educativa debe acercar a la dirección de turismo, tercera edad y recreación la autorización de la autoridad escolar correspondiente.</li>\n</ul>\n<strong>¿Quién lo puede realizar?:</strong>\n\nInstituciones Educativas, Clubes, Sociedades de Fomento y otras Instituciones de bien público de San Miguel.\n\n<strong>Costo del trámite:</strong>\n\nGratuito\n\n&nbsp;');
INSERT INTO `wp_postmeta` VALUES (4906,1011,'_lugar_de_atencion','Club Bella Vista, Entre Ríos 851');
INSERT INTO `wp_postmeta` VALUES (4907,1011,'_horarios_de_atencion','<ul>\n 	<li>De lunes a viernes de 8.00 a 14.00 hs.  Sin turno previo.</li>\n 	<li>Teléfono: 11285994618</li>\n 	<li>Correo Electrónico: <a href=\"mailto:plantadecampamentoslosindios@gmail.com\">plantadecampamentoslosindios@gmail.com</a></li>\n</ul>');
