INSERT INTO `wp_postmeta` VALUES (8910,2746,'_presentacion_del_tramite','Solicitud temporaria de las instalaciones de la Planta de campamentos “Los Indios”, que depende de la Subsecretaría de Deportes, sujeta a la aprobación correspondiente.');
INSERT INTO `wp_postmeta` VALUES (8911,2746,'_requisitos','<ol>\n 	<li>Formulario de solicitud de autorización actividades campamentiles con pernocte completo con la firma de un responsable de la Institución.</li>\n 	<li>Si se trata de una solicitud para una actividad escolar deberá presentar también la autorización de la autoridad escolar correspondiente.</li>\n</ol>');
INSERT INTO `wp_postmeta` VALUES (8912,2746,'_duracion_del_tramite','A partir de la presentación del formulario de solicitud completo, 48.00 hs. Luego deberá presentar la autorización de la autoridad escolar correspondiente.');
INSERT INTO `wp_postmeta` VALUES (8913,2746,'_vigencia_del_documento_obtenido','Hasta la finalización del evento por el cual se solicita la Planta de Campamentos.');
INSERT INTO `wp_postmeta` VALUES (8914,2746,'_respaldo_legal','');
INSERT INTO `wp_postmeta` VALUES (8915,2746,'_observaciones','<strong>Documento que se obtiene:</strong>\n\nComprobante de autorización de utilización del Predio.\n\n<strong>Descripción del trámite:</strong>\n<ul>\n 	<li>Descargar el <a href=\"/wp-content/uploads/2025/02/SOLICITUD-actividades-campamentiles-1.pdf\">formulario adjunto</a>, o solicitar una copia en la oficina de la Subsecretaría de Deportes.</li>\n 	<li>Completarlo y presentarlo en la Subsecretaría de Deportes.</li>\n 	<li>Verificar la aprobación de la fecha solicitada.</li>\n 	<li>En caso de tratarse de una salida educativa debe acercar a la dirección de turismo, tercera edad y recreación la autorización de la autoridad escolar correspondiente.</li>\n</ul>\n<strong>¿Quién lo puede realizar?:</strong>\n\nInstituciones Educativas, Clubes, Sociedades de Fomento y otras Instituciones de bien público de San Miguel.\n\n<strong>Costo del trámite:</strong>\n\nGratuito\n\n&nbsp;');
INSERT INTO `wp_postmeta` VALUES (8916,2746,'_lugar_de_atencion','Club Bella Vista, Entre Ríos 851');
INSERT INTO `wp_postmeta` VALUES (8917,2746,'_horarios_de_atencion','<ul>\n 	<li>De lunes a viernes de 8.00 a 14.00 hs.  Sin turno previo.</li>\n 	<li>Teléfono: 11285994618</li>\n 	<li>Correo Electrónico: <a href=\"mailto:plantadecampamentoslosindios@gmail.com\">plantadecampamentoslosindios@gmail.com</a></li>\n</ul>');
