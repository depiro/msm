INSERT INTO `wp_postmeta` VALUES (8940,2747,'_observaciones','<strong>Documento que se obtiene:</strong>\n\nComprobante de autorización de utilización del Predio.\n\n<strong>Descripción del trámite:</strong>\n<ul>\n 	<li>Descargar el <a href=\"https://www.msm.gov.ar/wp-content/uploads/2021/05/SOLICITUD-Actividades-Deportivas-y-Recreativas.pdf\">formulario</a> de la web o solicitar una copia en la oficina de la Subsecretaría de Deportes.</li>\n 	<li>Completarlo y presentarlo en la Subsecretaría de Deportes.</li>\n 	<li>Verificar la aprobación de la fecha solicitada.</li>\n 	<li>En caso de tratarse de una salida educativa debe acercar a la dirección de turismo, tercera edad y recreación la autorización de la autoridad escolar correspondiente.</li>\n</ul>\n<strong>¿Quién lo puede realizar?:</strong>\n\nInstituciones Educativas, Clubes, Sociedades de Fomento, Centros de Jubilados y otras Instituciones de bien público de San Miguel.\n\n&nbsp;');
