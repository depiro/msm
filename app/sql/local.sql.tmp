INSERT INTO `wp_postmeta` VALUES (5402,1037,'_presentacion_del_tramite','Informe sobre anegamientos por inundación en el partido de San Miguel, con posibles demoras y/o anulación de recorridos de transporte público.');
INSERT INTO `wp_postmeta` VALUES (5403,1037,'_requisitos','<ol>\n 	<li>Deberá suministrar sus datos personales (N° de DNI, nombre y apellido completo, domicilio y teléfono)</li>\n 	<li>Datos de su laboral (Nombre de la Empresa, Dirección y Teléfono)</li>\n 	<li>Lugar donde debería acceder al transporte público, día y horario que debería de haber accedido al mismo.</li>\n</ol>');
INSERT INTO `wp_postmeta` VALUES (5404,1037,'_duracion_del_tramite','10 minutos');
INSERT INTO `wp_postmeta` VALUES (5405,1037,'_vigencia_del_documento_obtenido','Solo justifica el día de emisión solicitado.');
INSERT INTO `wp_postmeta` VALUES (5406,1037,'_respaldo_legal','');
INSERT INTO `wp_postmeta` VALUES (5407,1037,'_observaciones','<strong>Descripción del trámite:</strong>\n<ol>\n 	<li>Cargar los datos personales</li>\n 	<li>Cargar los datos laborales</li>\n 	<li>Cargar los datos del día, hora y lugar donde accede a servicio público</li>\n</ol>\n<strong>Documento que se obtiene:</strong>\n\nPlanilla con la información de lluvias y anegamientos en el partido de San Miguel.\n\n<strong>¿Quién lo puede realizar?:</strong>\n\nVecino que debido a la inundación y/o anegamiento de calles o rutas, se ve impedido de asistir a su lugar de trabajo y/o debe de llegar tarde a trabajar.\n\n<strong>¿Cómo recibo el resultado del trámite?:</strong>\n\nEn el momento se entrega una planilla con la información.\n\n<strong>Costo del trámite:</strong>\n\nSin costo');
