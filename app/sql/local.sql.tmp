INSERT INTO `wp_postmeta` VALUES (7771,1254,'observaciones','Pasos a seguir:\n\n 	Ingresar en el siguiente link y gestionar la solicitud: https://www.gba.gob.ar/transporte/accesibilidad/pase_libre_multimodal\n\n\n 	Acercarse con esa solicitud en 3 meses o más, a la oficina de atención para retirar el pase.\n\n¿Cómo recibo el trámite?:\n\nSe retira por la oficina de atención.');
