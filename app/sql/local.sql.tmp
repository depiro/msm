INSERT INTO `wp_postmeta` VALUES (6127,1073,'_presentacion_del_tramite','Proceso al cual se debe someter una Industria, en caso de que querer ejecutar ampliaciones, modificaciones o cambios en sus procesos, edificios, ambientes o instalaciones, ya que esto seguramente impactará en el Nivel de Complejidad Ambiental actual, y se debe definir de esta manera a qué categoría corresponde, y por consiguiente solicitar el Certificado de Aptitud Ambiental.');
INSERT INTO `wp_postmeta` VALUES (6128,1073,'_requisitos','Haber clasificado previamente.');
INSERT INTO `wp_postmeta` VALUES (6129,1073,'_duracion_del_tramite','1 mes');
INSERT INTO `wp_postmeta` VALUES (6130,1073,'_vigencia_del_documento_obtenido','Hasta que se genere una modificación considerable en los procesos productivos de la industria, o haya cambio de rubro.');
INSERT INTO `wp_postmeta` VALUES (6131,1073,'_respaldo_legal','Ley 11459 Decretos Reglamentarios 531/2019 y 973/2020. Ordenanza 05/2021');
INSERT INTO `wp_postmeta` VALUES (6132,1073,'_observaciones','<strong>ORGANISMOS RESPONSABLE:</strong> Ministerio de Ambiente de la Provincia de Buenos Aires, Subsecretaría de Ambiente - Dirección de Evaluación y Control Ambiental.\n\nEl Organismo responsable de dar respuesta al trámite es el Ministerio de Ambiente de la Provincia de Bs. AS., no depende de la Dirección de Evaluación y Control Ambiental de la Municipalidad de San Miguel.\n\nTodas las notificaciones del trámite serán informadas en la casilla de mensajes del portal de Trámites del Ministerio de Ambiente de la PBA.\n\nEste trámite resulta vital para habilitar la instancia de obtención del CAA. Sin dicho Certificado, el funcionamiento del establecimiento se encontrará en infracción a la Ley Provincial N° 11.459.\n\n<strong>DURACIÓN DEL TRÁMITE:</strong> 1 mes\n\n<strong>COSTO:</strong> No hay costo Municipal, solo lo que determine el Ministerio de Ambiente del PBA.\n\n<strong>QUIEN LO PUEDE REALIZAR:</strong> Establecimientos industriales que proyecten realizar acciones que modifiquen su Nivel de Complejidad Ambiental (aumento de superficie, de potencia instalada, rubro, etc.).\n\n<strong>DESCRIPCIÓN DEL TRAMITE:</strong>\n<ol>\n 	<li>Ingresar a <a href=\"http://www.sitdt.gba.gob.ar/Account/Login?ReturnUrl=%2f\">http://www.sitdt.gba.gob.ar/Account/Login?ReturnUrl=%2f</a>,</li>\n 	<li>Dirigirse a la solapa de “DESARROLLO DE TRAMITES”</li>\n 	<li>Dirigirse a la solapa de “CERTIFICADO DE APTITUD AMBIENTAL”</li>\n 	<li>Dirigirse a la solapa de “CLASIFICACIÓN DEL NIVEL DE COMPLEJIDAD AMBIENTAL”</li>\n 	<li>Dirigirse a <strong>“RECLASIFICACIÓN”</strong></li>\n</ol>\n<strong>DOCUMENTO QUE SE OBTIENE:</strong> Disposición de Reclasificación - Certificado de Aptitud Ambiental (CAA)\n\n&nbsp;');
INSERT INTO `wp_postmeta` VALUES (6133,1073,'_lugar_de_atencion','Ministerio de Ambiente de la Provincia de Buenos Aires <a href=\"http://www.sitdt.gba.gov.ar/Home/Star\">http://www.sitdt.gba.gov.ar/Home/Star</a>');
