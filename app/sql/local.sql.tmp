INSERT INTO `wp_postmeta` VALUES (7662,1248,'_presentacion_del_tramite','En caso de tener un emprendimiento y necesitar financiamiento para la adquisición de un capital de trabajo, materia prima, o insumos, la municipalidad tiene un programa con fondos propios y tasa subsidiada para ayudar al crecimiento.');
INSERT INTO `wp_postmeta` VALUES (7663,1248,'_requisitos','<ul>\n 	<li>Tener un emprendimiento con mínimo 8 meses de antigüedad.</li>\n 	<li>Tener domicilio fiscal en el partido de san miguel</li>\n 	<li>Tener activo el monotributo e IIBB, o estar en trámite.</li>\n 	<li>Llenar la planilla de aplicación (Se hace de manera presencial)</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (7664,1248,'_duracion_del_tramite','30 días');
INSERT INTO `wp_postmeta` VALUES (7665,1248,'_vigencia_del_documento_obtenido','El microcrédito tiene una duración variable de entre 12 a 48 cuotas semanales, esto depende el monto adjudicado y la capacidad de pago.');
INSERT INTO `wp_postmeta` VALUES (7666,1248,'_respaldo_legal','');
INSERT INTO `wp_postmeta` VALUES (7667,1248,'_observaciones','<strong>Descripción del trámite:</strong>\n\nComunicarse con la oficina por cualquiera de sus medios, para concretar una entrevista.\n\n<strong>Documento que se obtiene:</strong>\n<ul>\n 	<li>Denegación del microcrédito, por diferentes factores.</li>\n 	<li>Aprobación del microcrédito, con el cual se obtendrá un financiamiento con fondos municipales, a tasa subsidiada.</li>\n</ul>\n<strong>¿Quién lo puede realizar?:</strong>\n\nEmprendedores mayores de 18 años que residan en el partido de san miguel, y realicen actividades de producción y/o comercialización de bienes y/o servicios.\n\n<strong>Costo del trámite:</strong>\n\nSin costo.');
INSERT INTO `wp_postmeta` VALUES (7668,1248,'_lugar_de_atencion','<strong>Presencial: </strong>Primera Junta 3349 1° piso, B° Don Alfonso. <strong>Por E-mail a:</strong> <a href=\"mailto:sanmiguelemprende@msm.gov.ar\">sanmiguelemprende@msm.gov.ar</a> Enviando Whatsapp al: 11-2859-4565');
INSERT INTO `wp_postmeta` VALUES (7669,1248,'_horarios_de_atencion','De Lunes a Viernes de 09 a 15');
