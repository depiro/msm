INSERT INTO `wp_postmeta` VALUES (5027,1015,'_presentacion_del_tramite','RETIRO EL CERTIFICADO EN LA DIRECCIÓN DE HABILITACIONES, PREVIA COMUNICACIÓN TELEFÓNICA DE SU REGISTRO.\nEN SU DEFECTO SERA ENTREGADO EN SU COMERCIO POR PERSONAL MUNICIPAL.');
