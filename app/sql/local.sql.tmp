INSERT INTO `wp_postmeta` VALUES (6918,1106,'lugar','Presencial Dirección de Tasas Generales, Tasa por Inspección de Seguridad e Higiene, previa solicitud de nro. en INFORMES, Belgrano 1342');
INSERT INTO `wp_postmeta` VALUES (6919,1106,'observaciones','QUIEN LO PUEDE REALIZAR:\n\nContribuyentes que posean comercios inscriptos en la tasa por inspección de seguridad e higiene\n\nDESCRIPCION DEL TRAMITE\n\n 	Titular o responsable del comercio debe completar el formulario/ solicitud de baja retroactiva, indicando la fecha de cese.\n 	Una vez completo, presentar el formulario original y una copia, junto a un recibo de sellado para inicio de expediente en Tasas Generales.\n 	Iniciado el Expte. se gira a Inspecciones para verificar la fecha de cese, una vez informado se envía a la Dirección de Tasas Generales para la prosecución del trámite.\n\nSe informará telefónicamente cuando el trámite esté en condiciones para proseguir, se deberá presentar en Cámara de Comercio la documentación requerida para realizar el\n\nCOSTO:\n\nSEGÚN ORDENANZA TARIFIARIA VIGENTE\n\n&nbsp;');
