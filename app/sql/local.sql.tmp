INSERT INTO `wp_postmeta` VALUES (5601,1046,'atiende_24hs','no');
INSERT INTO `wp_postmeta` VALUES (5602,1046,'_presentacion_del_tramite','Cuando se quiera ejecutar una obra nueva (están excluidos de este trámite las ampliaciones o regularizaciones de obra) con destino vivienda unifamiliar, debe efectuarse este trámite previo a iniciar cualquier tipo de actividad de naturaleza constructiva.');
INSERT INTO `wp_postmeta` VALUES (5603,1046,'_requisitos','<ol>\n 	<li>Documentación para la presentación e inicio de expediente - <a href=\"/wp-content/uploads/2025/02/Requisitos-para-presentacion-de-expedientes.pdf\">ARCHIVO PARA DESCARGAR</a></li>\n 	<li>Planilla de Derechos de Construcción</li>\n 	<li>Modelo de carátula - <a href=\"/wp-content/uploads/2025/02/Modelos-de-caratulas.pdf\">ARCHIVO PARA DESCARGAR</a></li>\n</ol>');
INSERT INTO `wp_postmeta` VALUES (5604,1046,'_duracion_del_tramite','La duración de cada trámite será variable en función a la complejidad de cada caso en particular.');
INSERT INTO `wp_postmeta` VALUES (5605,1046,'_vigencia_del_documento_obtenido','Permanente');
INSERT INTO `wp_postmeta` VALUES (5606,1046,'_respaldo_legal','<ul>\n 	<li>Código de Zonificación – Ordenanza nº 14/2012</li>\n 	<li>Reglamento de construcciones, Ordenanza nº 595/82</li>\n 	<li>Ordenanza Tarifaria y Fiscal Vigente nº 32/17</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (5607,1046,'_observaciones','<strong>Descripción del trámite:</strong>\n<ol>\n 	<li>Para dar inicio al expediente, debe dirigirse con la carpeta de obra y la documentación requerida al sector de Mesa de Entrada (Planta Baja).</li>\n 	<li>Una vez iniciado el expediente, el mismo es girado internamente a la Subsecretaría de Obras Particulares y Desarrollo Urbano, y luego a la Dirección de Catastro donde se realiza el primer visado. En caso de cumplimentar todos los requisitos es girado internamente a la Dirección de Obras Particulares, donde se realiza el visado correspondiente.</li>\n 	<li>Dirigirse a Obras Particulares con número de expediente y retirar copia visada y parcelario.</li>\n 	<li>Dirigirse a Rentas (Municipal, en Planta Baja) y dejar Parcelario para su liberación.</li>\n 	<li>Realizadas las correcciones correspondientes según visados, completar planilla de liquidación de derechos, y dirigirse a Obras Particulares donde se emite la factura para el pago de los mismos.</li>\n 	<li>Teniendo toda la documentación necesaria para la prosecución del trámite (ver planilla adjunta) retornar a Obras Particulares para adjuntarla el expediente.</li>\n</ol>\n<strong>Documento que se obtiene:</strong>\n\nPlano de obra aprobado – Permiso de obra.\n\n<strong>¿Quién lo puede realizar?:</strong>\n\nArquitectos, Ingenieros Civiles o en construcción, Maestros Mayores de Obras u otros con incumbencias, matriculados en el Municipio.\n\n<strong>Costo del trámite:</strong>\n\n<a href=\"/boletin-oficial/\">Ordenanza Tarifaria</a>\n\n&nbsp;');
INSERT INTO `wp_postmeta` VALUES (5608,1046,'_lugar_de_atencion','Dirección de Obras Particulares, Belgrano 1342, 3º piso.');
INSERT INTO `wp_postmeta` VALUES (5609,1046,'_horarios_de_atencion','Lunes a Viernes de 08 a 14hs');
