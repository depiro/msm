INSERT INTO `wp_postmeta` VALUES (7162,1132,'_presentacion_del_tramite','La Factibilidad de Radicación de Comercios y Servicios es un paso obligatorio para habilitar un rubro según el Código de Zonificación. También se requiere tramitar la Factibilidad en la habilitación de estructuras comerciales y debe realizarse de forma paralela al trámite en la Dirección de Obras Particulares, donde se valida el Plano de Obra y se evalúa su viabilidad.');
INSERT INTO `wp_postmeta` VALUES (7163,1132,'_requisitos','<ul>\n 	<li>Formulario de Factibilidad de Radicación completo.</li>\n 	<li><strong>TSM o Partida Municipal.</strong></li>\n 	<li>Estatuto de Sociedad (para Personas Jurídicas).</li>\n 	<li>Certificado de Habilitación o Resolución de Habilitación anterior (si aplica).</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (7164,1132,'_duracion_del_tramite','<ul>\n 	<li>24 horas hábiles para rubros de impacto bajo.</li>\n 	<li>3 dias hábiles para rubros de impacto alto.</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (7165,1132,'_vigencia_del_documento_obtenido','El <strong>Certificado de Factibilidad Aprobada</strong> o la <strong>Resolución de Radicación</strong> tiene una validez de <strong>1 año</strong> desde su fecha de emisión.');
INSERT INTO `wp_postmeta` VALUES (7166,1132,'_respaldo_legal','<ul>\n 	<li>Ordenanza Municipal 30/2019</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (7167,1132,'_observaciones','<h3><strong>DESCRIPCIÓN DEL TRÁMITE:</strong></h3>\nLa <strong>Factibilidad de Radicación de Comercios y Servicios</strong> es un paso obligatorio para habilitar un rubro según el <strong>Código de Zonificación</strong>.\nTambién se requiere tramitar la Factibilidad en la habilitación de estructuras comerciales y debe realizarse de forma paralela al trámite en la Dirección de Obras Particulares, donde se valida el <strong>Plano de Obra</strong> y se evalúa su viabilidad.\n\n<strong>DOCUMENTO QUE SE OBTIENE:</strong>\n<ul>\n 	<li>Certificado de Factibilidad Aprobada.</li>\n 	<li>Resolución de Radicación.</li>\n 	<li>Resolución de Denegatoria (en caso de no cumplir con los requisitos).</li>\n</ul>\n<h3><strong>PASOS A SEGUIR:</strong></h3>\n<ol>\n 	<li><strong>Completar el formulario:</strong> Descargar y completar el <strong>Formulario de Factibilidad de Radicación</strong> disponible en la sección de “plantillas/modelos” del portal de Ventanilla Única.</li>\n 	<li><strong>Subir la documentación:</strong> Presentar toda la documentación requerida en el <a href=\"https://ventanillaunica.msm.gov.ar/PortalTramites/Account/Login\">PORTAL DE TRAMITES</a>.</li>\n 	<li><strong>Evaluación técnica y administrativa:</strong> La Dirección General de Habilitaciones Comerciales realiza un análisis del expediente.</li>\n 	<li><strong>Descarga del resultado:</strong> Según la evaluación, se emite un <strong>Certificado de Factibilidad</strong>, una <strong>Resolución de Radicación</strong> o una <strong>Resolución de Denegatoria</strong>, que podrá descargarse desde el portal en la sección \"documentación\".</li>\n 	<li><strong>Proseguir con la habilitación:</strong> En caso de aprobación, podrá iniciar el trámite de habilitación correspondiente.</li>\n</ol>\n<h3><strong>¿QUIÉN PUEDE REALIZAR EL TRÁMITE?</strong></h3>\n<ul>\n 	<li>Persona Física mayor de 18 años.</li>\n 	<li>Persona Jurídica que desee habilitar un comercio o servicio en el Partido de San Miguel.</li>\n</ul>\n<h3><strong>¿CÓMO RECIBO EL RESULTADO DEL TRÁMITE?</strong></h3>\n<ul>\n 	<li>El documento final estará disponible para descargar en el <a href=\"https://ventanillaunica.msm.gov.ar/PortalTramites/Account/Login\">PORTAL DE TRAMITES</a>. El solicitante deberá ingresar a su trámite y buscar el archivo en la sección \"documentación\".</li>\n</ul>\n<strong>COSTO DEL TRÁMITE:</strong>\n<ul>\n 	<li><strong>Gratuito</strong></li>\n</ul>\n&nbsp;');
INSERT INTO `wp_postmeta` VALUES (7168,1132,'_lugar_de_atencion','El trámite se realiza de manera <strong>virtual</strong> a través del portal web de  <a href=\"https://ventanillaunica.msm.gov.ar/PortalTramites/Account/Login\">PORTAL DE TRAMITES</a>');
INSERT INTO `wp_postmeta` VALUES (7169,1132,'_horarios_de_atencion','24hs.\n\n<strong>CONTACTO:\n</strong>WhatsApp de Ayuda en Línea: <strong>11-3884-9649</strong>. Brindamos ayuda para ingresos de trámites y asesoramientos.');
INSERT INTO `wp_postmeta` VALUES (7170,1132,'lugar','El trámite se realiza de manera virtual a través del portal web de  PORTAL DE TRAMITES');
INSERT INTO `wp_postmeta` VALUES (7171,1132,'observaciones','DESCRIPCIÓN DEL TRÁMITE:\nLa Factibilidad de Radicación de Comercios y Servicios es un paso obligatorio para habilitar un rubro según el Código de Zonificación.\nTambién se requiere tramitar la Factibilidad en la habilitación de estructuras comerciales y debe realizarse de forma paralela al trámite en la Dirección de Obras Particulares, donde se valida el Plano de Obra y se evalúa su viabilidad.\n\nDOCUMENTO QUE SE OBTIENE:\n\n 	Certificado de Factibilidad Aprobada.\n 	Resolución de Radicación.\n 	Resolución de Denegatoria (en caso de no cumplir con los requisitos).\n\nPASOS A SEGUIR:\n\n 	Completar el formulario: Descargar y completar el Formulario de Factibilidad de Radicación disponible en la sección de “plantillas/modelos” del portal de Ventanilla Única.\n 	Subir la documentación: Presentar toda la documentación requerida en el PORTAL DE TRAMITES.\n 	Evaluación técnica y administrativa: La Dirección General de Habilitaciones Comerciales realiza un análisis del expediente.\n 	Descarga del resultado: Según la evaluación, se emite un Certificado de Factibilidad, una Resolución de Radicación o una Resolución de Denegatoria, que podrá descargarse desde el portal en la sección \"documentación\".\n 	Proseguir con la habilitación: En caso de aprobación, podrá iniciar el trámite de habilitación correspondiente.\n\n¿QUIÉN PUEDE REALIZAR EL TRÁMITE?\n\n 	Persona Física mayor de 18 años.\n 	Persona Jurídica que desee habilitar un comercio o servicio en el Partido de San Miguel.\n\n¿CÓMO RECIBO EL RESULTADO DEL TRÁMITE?\n\n 	El documento final estará disponible para descargar en el PORTAL DE TRAMITES. El solicitante deberá ingresar a su trámite y buscar el archivo en la sección \"documentación\".\n\nCOSTO DEL TRÁMITE:\n\n 	Gratuito\n\n&nbsp;');
