INSERT INTO `wp_postmeta` VALUES (7879,1262,'_edit_last','1');
INSERT INTO `wp_postmeta` VALUES (7880,1262,'_presentacion_del_tramite','En caso de robo o extravío de la licencia de conducir, es posible solicitar un duplicado o reemplazo de la misma. Pueden solicitar su duplicado o reemplazo todas las personas con licencia de conducir y DNI con domicilio en San Miguel.');
INSERT INTO `wp_postmeta` VALUES (7881,1262,'_requisitos','<ul>\n 	<li>DNI o comprobante de DNI en trámite con domicilio en San Miguel, fotocopia de DNI, Licencia de Conducir y fotocopia de la Licencia de Conducir, o denuncia de robo o extravío impresa.</li>\n 	<li>Denuncia de robo emitida en comisaría o de extravío realizada en el Registro Civil y su respectiva fotocopia.</li>\n 	<li>Si poseía clases profesionales deberá presentar Certificado de Antecedentes Penales impreso. Este mismo tiene una validez de 30 días desde el momento de sue emisión.</li>\n 	<li>No debe poseer multas impagas.</li>\n 	<li>Certificado de Legalidad impreso si tu licencia fue emitida en CABA o en alguna otra provincia (Que no sea Buenos Aires).</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (7882,1262,'_duracion_del_tramite','1 hora y media. Aproximadamente.');
INSERT INTO `wp_postmeta` VALUES (7883,1262,'_vigencia_del_documento_obtenido','El duplicado conserva el mismo vencimiento de la licencia extraviada o robada.');
INSERT INTO `wp_postmeta` VALUES (7884,1262,'_respaldo_legal','<a href=\"https://www.msm.gov.ar/wp-content/uploads/2013/11/LEY_13927.pdf\">Ley Pcial. de Tránsito 13927</a> <a href=\"https://www.msm.gov.ar/wp-content/uploads/2013/11/Reglamentaci%C3%B3n-de-la-ley-13927.pdf\">Reglamentación de la ley 13,927</a>');
INSERT INTO `wp_postmeta` VALUES (7885,1262,'_observaciones','<strong>Documentación necesaria:</strong>\n<ul>\n 	<li>DNI o comprobante de DNI en trámite con domicilio en el partido de San Miguel. Concurrir con una fotocopia del mismo</li>\n 	<li>Licencia de conducir o denuncia de robo o extravío impresa</li>\n 	<li>Aprobar psicofísico, exámenes teórico y práctico</li>\n 	<li>Abonar tasas nacionales, provinciales y municipales</li>\n 	<li>No debes poseer infracciones impagas</li>\n 	<li>Certificado de antecedentes penales (solo clases profesionales).</li>\n</ul>\n<strong>Trámites relacionados:</strong>\n\nLibre deuda de multas que se tramita en el mismo lugar y en el mismo momento.\n\n<strong>Descripción del trámite:</strong>\n<ul>\n 	<li>Debe solicitar turno en <a href=\"/licencias-2/\">aquí</a> o llamando al 147.</li>\n 	<li>Acercarse a la oficina de Licencias de Conducir (Perón 415, Muñiz) en la fecha y 10 minutos antes de la hora asignada.</li>\n 	<li>Registrate con tu número de DNI en el totem que está ubicado en la recepción, retirá el ticket con el código que te otorga, el mismo será anunciado por pantalla para que inicies el trámite.</li>\n 	<li>El día del turno realizarás un control psicofísico. Además cargaremos sus datos biométricos, verificaremos infracciones de tránsito e indicaremos cómo resolverlas si están pendiente de regularización</li>\n 	<li>En caso de aprobar todas las instancias, en 30 minutos se le entregará la nueva licencia.</li>\n</ul>\n<strong>Costo del trámite:</strong>\n<ul>\n 	<li>Público General: $29.600</li>\n 	<li>Jubilados Mayores de 70: $9850 (Presentar copia del recibo de haberes)</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (7886,1262,'_lugar_de_atencion','Pte. Perón 415 Muñiz. Dirección licencias de conducir. <a href=\"/licencias-2/\">Solicitar turno desde la Web</a>');
INSERT INTO `wp_postmeta` VALUES (7887,1262,'_horarios_de_atencion','De lunes a viernes de 8hs a 14hs. Asistir al horario del turno asignado');
INSERT INTO `wp_postmeta` VALUES (7888,1262,'lugar','Pte. Perón 415 Muñiz. Dirección licencias de conducir. Solicitar turno desde la Web');
INSERT INTO `wp_postmeta` VALUES (7889,1262,'observaciones','Documentación necesaria:\n\n 	DNI o comprobante de DNI en trámite con domicilio en el partido de San Miguel. Concurrir con una fotocopia del mismo\n 	Licencia de conducir o denuncia de robo o extravío impresa\n 	Aprobar psicofísico, exámenes teórico y práctico\n 	Abonar tasas nacionales, provinciales y municipales\n 	No debes poseer infracciones impagas\n 	Certificado de antecedentes penales (solo clases profesionales).\n\nTrámites relacionados:\n\nLibre deuda de multas que se tramita en el mismo lugar y en el mismo momento.\n\nDescripción del trámite:\n\n 	Debe solicitar turno en aquí o llamando al 147.\n 	Acercarse a la oficina de Licencias de Conducir (Perón 415, Muñiz) en la fecha y 10 minutos antes de la hora asignada.\n 	Registrate con tu número de DNI en el totem que está ubicado en la recepción, retirá el ticket con el código que te otorga, el mismo será anunciado por pantalla para que inicies el trámite.\n 	El día del turno realizarás un control psicofísico. Además cargaremos sus datos biométricos, verificaremos infracciones de tránsito e indicaremos cómo resolverlas si están pendiente de regularización\n 	En caso de aprobar todas las instancias, en 30 minutos se le entregará la nueva licencia.\n\nCosto del trámite:\n\n 	Público General: $29.600\n 	Jubilados Mayores de 70: $9850 (Presentar copia del recibo de haberes)');
