INSERT INTO `wp_postmeta` VALUES (7187,1134,'_presentacion_del_tramite','El trámite es virtual y no tiene costo alguno a excepción de los Rubros de Impacto Alto o con una superficie comercial mayor o igual a 200 metros cuadrados, a ellos se le cobra la Tasas por Derecho de Habilitación de Comercios e Industrias.\nCon el objetivo de brindar un servicio eficiente y una atención más personalizada, contamos con el Whatsapp de “Ayuda en Línea” 11 3884-9649 o al teléfono fijo 6091-7100 (interno 5863) que se encuentra disponible de lunes a viernes en el horario de 8 a 16 Hs, o también podrán acercarse a nuestra Oficina en Sarmiento 1686 que se encuentra atendiendo en el horario de 8 a 14 Hs.');
INSERT INTO `wp_postmeta` VALUES (7188,1134,'_requisitos','Certificado Parcelario y Habilitación Comercial. Se realiza para habilitaciones nuevas que deberán presentar Plano de Obra Aprobado\ncon Destino Comercial.\nLos requisitos son:\n● Certificado de Factibilidad.\n● Contrato de Locación, Comodato timbrado por ARBA y firmado por las partes, o Escritura firmada por un escribano junto con un Impuesto Inmobiliario.\n● Solicitud de Habilitación.\n● Certificados de Inscripción en AFIP y ARBA (si aplica) con domicilio comercial, titular y actividad registrados.\n● Estatuto de Sociedad (si es necesario).\n● Plano de Obra Aprobado con Destino Comercial.\n\nSi el rubro tiene alto impacto o el inmueble supera los 200 metros cuadrados, también se requieren:\n● CAIE (Certificado de Aptitud de Instalaciones Eléctricas).\n● Plano e Informe Antisiniestral Aprobado por Bomberos.\n- Regularización Comercial. Se realiza para habilitaciones nuevas que no cuentan con Plano de Obra Aprobado con Destino Comercial.\nLos requisitos son:\n● Certificado de Factibilidad.\n● Contrato de Locación, Comodato timbrado por ARBA y firmado por las partes, o Escritura firmada por un escribano junto con un Impuesto Inmobiliario.\n● Solicitud de Habilitación.\n● Certificados de Inscripción en AFIP y ARBA (si aplica) con domicilio comercial, titular y actividad registrados.\n● Estatuto de Sociedad (si es necesario).\n● Croquis detallado.\n\nSi el rubro tiene alto impacto o el inmueble supera los 200 metros cuadrados, también se requieren:\n● CAIE (Certificado de Aptitud de Instalaciones Eléctricas).\n● Plano e Informe Antisiniestral Aprobado por Bomberos.');
