INSERT INTO `wp_postmeta` VALUES (6103,1072,'_requisitos','Poseer un comercio dentro del Área de Estacionamiento Medido de San Miguel\n<ul>\n 	<li>Descargar formulario, completarlo y presentarlo en la Oficina de Estacionamiento Medido. <a href=\"https://www.msm.gov.ar/wp-content/uploads/2021/02/Datos-para-el-Alta.docx\" target=\"_blank\" rel=\"noopener\">AQUÍ</a></li>\n 	<li>Una vez presentado el formulario, la la Dirección de Estacionamiento Medido evaluará la situación particular del comercio para luego indicar si se le dará el alta como Punto de Venta.</li>\n</ul>');
