INSERT INTO `wp_postmeta` VALUES (8009,1267,'_respaldo_legal','Regularización Dominial en el Marco de Interés Social – <a href=\"http://servicios.infoleg.gob.ar/infolegInternet/anexos/90000-94999/90294/norma.htm\">Ley 25.797</a>');
INSERT INTO `wp_postmeta` VALUES (8010,1267,'_observaciones','<strong>Descripción del trámite:</strong>\n\nPresentarse en Oficina 19 de Subsecretaría de Tierras, Vivienda y Urbanismo.\n\n<strong>Documento que se obtiene:</strong>\n\nInscripción del bien en el Registro de la Propiedad con escrituración definitiva.\n\n<strong>¿Quién lo puede realizar?:</strong>\n\nA aquellos vecinos que oportunamente iniciaron la Regularización Dominial en el marco de la Ley 24.374, y cumplido el tiempo para su consolidación, esta debe hacerse efectiva (10 años).\n\n<strong>¿Cómo recibo el resultado del trámite?:</strong>\n\nMediante llamado, correo electrónico, y notificación al domicilio del vecino, citándolo para retirar la Escritura.\n\n<strong>Costo del trámite:</strong>\n\nSin costo.');
