INSERT INTO `wp_postmeta` VALUES (7787,1259,'_presentacion_del_tramite','El certificado de legalidad le permite a una persona realizar un trámite (Renovación, Ampliación, etc) en otro país u otra provincia que no sea Buenos Aires. En caso de tener que realizar alguno de estos trámites en alguno de los 135 municipios de la Provincia de Buenos Aires, no es necesario solicitar el certificado de legalidad. Podrán realizar el trámite todas aquellas personas que cuenten con una licencia emitida por la Municipalidad de San Miguel.');
INSERT INTO `wp_postmeta` VALUES (7788,1259,'_requisitos','<ul>\n 	<li>DNI con domicilio que no sea en alguna jurisdicción de la Provincia de Buenos Aires</li>\n 	<li>Licencia de conducir emitida por el Municipio de San Miguel</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (7789,1259,'_duracion_del_tramite','15 minutos.');
INSERT INTO `wp_postmeta` VALUES (7790,1259,'_vigencia_del_documento_obtenido','30 días a partir de la emisión del mismo.');
INSERT INTO `wp_postmeta` VALUES (7791,1259,'_respaldo_legal','<a href=\"https://www.msm.gov.ar/wp-content/uploads/2013/11/LEY_13927.pdf\">Ley Pcial. de Tránsito 13927</a> <a href=\"https://www.msm.gov.ar/wp-content/uploads/2013/11/Reglamentaci%C3%B3n-de-la-ley-13927.pdf\">Reglamentación de la ley 13,927</a>');
INSERT INTO `wp_postmeta` VALUES (7792,1259,'_observaciones','Este trámite es necesario en las siguientes ocasiones:\n<ul>\n 	<li>Si renovás o cambiás la clase de licencia de conductor en un municipio distinto al que te la otorgó.</li>\n 	<li>Cuando te vas a radicar a otro país y vas a tramitar tu licencia en el exterior.</li>\n 	<li>A requerimiento del ciudadano por motivos particulares (Ej. para ser presentado en una empresa de transporte</li>\n</ul>\nSi tenés una Licencia Nacional de Conducir emitida en alguno de los 135 Municipios de la Provincia y querés realizar un trámite (renovación, duplicado, ampliación u otro) en otra jurisdicción municipal de la Provincia, no necesitas el certificado de legalidad, siempre y cuando la Licencia se encuentre registrada en el Sistema. Este documento NO habilita a conducir.\n\n<strong>Descripción del trámite:</strong>\n\nAl llegar a la sucursal (PERÓN 415, Muñiz) acercate al el totem que está ubicado en la recepción, retirá un ticket para certificado de legalidad, el mismo será anunciado por pantalla para que inicies el trámite.\n\n<strong>Documento que se obtiene:</strong>\n\nCertificado de Legalidad\n<ul>\n 	<li>Documento que certifica la legalidad de una licencia emitida en un Municipio para ser presentado en otro y tramitar alli la renovación.</li>\n</ul>\n<strong>¿Quién lo puede realizar?:</strong>\n\nEl interesado o un tercero con autorización del titular.\n\n<strong>¿Cómo recibo el resultado del trámite?:</strong>\n\nSe retira en el momento, debe contener sello y firma de una persona autorizada por el Municipio.\n\n<strong>Costo del trámite:</strong>\n\n$705.-');
INSERT INTO `wp_postmeta` VALUES (7793,1259,'_lugar_de_atencion','Perón 415 Muñiz. Dirección licencias de conducir.');
INSERT INTO `wp_postmeta` VALUES (7794,1259,'_horarios_de_atencion','<ul>\n 	<li>Presencial: De lunes a viernes de 8hs a 14hs sin turno.</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (7795,1259,'lugar','Perón 415 Muñiz. Dirección licencias de conducir.');
INSERT INTO `wp_postmeta` VALUES (7796,1259,'observaciones','Este trámite es necesario en las siguientes ocasiones:\n\n 	Si renovás o cambiás la clase de licencia de conductor en un municipio distinto al que te la otorgó.\n 	Cuando te vas a radicar a otro país y vas a tramitar tu licencia en el exterior.\n 	A requerimiento del ciudadano por motivos particulares (Ej. para ser presentado en una empresa de transporte\n\nSi tenés una Licencia Nacional de Conducir emitida en alguno de los 135 Municipios de la Provincia y querés realizar un trámite (renovación, duplicado, ampliación u otro) en otra jurisdicción municipal de la Provincia, no necesitas el certificado de legalidad, siempre y cuando la Licencia se encuentre registrada en el Sistema. Este documento NO habilita a conducir.\n\nDescripción del trámite:\n\nAl llegar a la sucursal (PERÓN 415, Muñiz) acercate al el totem que está ubicado en la recepción, retirá un ticket para certificado de legalidad, el mismo será anunciado por pantalla para que inicies el trámite.\n\nDocumento que se obtiene:\n\nCertificado de Legalidad\n\n 	Documento que certifica la legalidad de una licencia emitida en un Municipio para ser presentado en otro y tramitar alli la renovación.\n\n¿Quién lo puede realizar?:\n\nEl interesado o un tercero con autorización del titular.\n\n¿Cómo recibo el resultado del trámite?:\n\nSe retira en el momento, debe contener sello y firma de una persona autorizada por el Municipio.\n\nCosto del trámite:\n\n$705.-');
