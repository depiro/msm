INSERT INTO `wp_postmeta` VALUES (7104,1116,'_presentacion_del_tramite','Para iniciar el trámite debe completar los formularios de solicitud para eximición de la tasa por servicios municipales.');
INSERT INTO `wp_postmeta` VALUES (7105,1116,'_requisitos','<strong>PERSONAS FÍSICAS</strong>\n<ul>\n 	<li>Formulario de declaración jurada</li>\n 	<li>Escritura o boleto de compra del inmueble certificado ante escribano público. El límite de superficie cubierta debe ser de 110 m2, <strong>EXEPTO VETERANOS</strong></li>\n 	<li>El inmueble deberá ser única propiedad, usufructo o posesión del solicitante y ser ocupado de manera permanente por el/los beneficiarios</li>\n 	<li>DNI del solicitante y convivientes en caso de corresponder</li>\n 	<li>Boleta de tasa municipal de la partida municipal</li>\n 	<li>RUB en ANSES o IMPRESIÓN DE BENEFICIOS en IPS, recibo de haberes de los integrantes del grupo familiar conviviente y/o negativa de Anses (Mayores de 18 años)</li>\n 	<li>Certificado de Discapacidad (De corresponder)</li>\n 	<li>Certificado de veterano de guerra de Malvinas (De corresponder)</li>\n 	<li>El máximo de ingreso que podrá tener el grupo familiar son de 2.5 haberes mínimos previsionales</li>\n</ul>\n<strong>ENTIDADES SIN FINES DE LUCRO</strong>\n<ul>\n 	<li>Solicitud de pedido de eximición de TSM</li>\n 	<li>Cartón de habilitación municipal</li>\n 	<li>Constancia de inscripción AFIP/ARBA</li>\n 	<li>Estatuto social y/o acta constitutiva debidamente inscriptos en la I.G.J</li>\n 	<li>DNI del representante legal, legitimación del firmante</li>\n 	<li>Escritura o boleto de compra del inmueble o contrato de locación ante escribano público</li>\n 	<li>Memoria, balance general, estado de resultado, cuadros y anexos de los últimos (3) ejercicios económicos debidamente certificados por el Contador Público y correspondiente Consejo Profesional</li>\n 	<li>Boleta de Tasa Municipal de la/s partidas municipales</li>\n 	<li>BECAS/PRESTACIONES efectivamente ofrecidas y su valuación correspondiente</li>\n</ul>\n<strong>ENTIDADES RELIGIOSAS</strong>\n<ul>\n 	<li>Solicitud de pedido de eximición de TSM</li>\n 	<li>Certificado de registro de firmas en el Registro Nacional de Cultos</li>\n 	<li>Constancia de inscripción AFIP/ARBA</li>\n 	<li>DNI del representante legal, legitimación del firmante</li>\n 	<li>Escritura o boleto de compra del inmueble o contrato de locación ante escribano público</li>\n 	<li>Estatuto y/o acta constitutiva</li>\n 	<li>Recibo de Tasa Municipal de la/s partidas municipales</li>\n</ul>\nSegún corresponda el formulario de solicitud de entidades y la declaración jurada jubilados y pensionados- discapacitados, veteranos. <strong><a href=\"/wp-content/uploads/2025/02/DECLARACION-JURADA-JUBILADOS-Y-PENSIONADOS-2024.docx\">FORMULARIO</a></strong>\n\n<hr />\n\nPara envíar la documentación o cualquier consulta pueden comunicarse por correo electrónico a <a href=\"mailto:exenciones@msm.gov.ar\">exenciones@msm.gov.ar</a> En caso de envíar la documentación, esta será evaluada por el personal del área. El envió de la documentación no significa que el trámite este aprobado. <strong> </strong>');
INSERT INTO `wp_postmeta` VALUES (7106,1116,'_duracion_del_tramite','');
INSERT INTO `wp_postmeta` VALUES (7107,1116,'_vigencia_del_documento_obtenido','<ul>\n 	<li>El certificado de eximición entregado es un documento que acredita la eximición de la tasa por el año/s solicitado/s.</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (7108,1116,'_respaldo_legal','<a href=\"/boletin-oficial/\" target=\"_blank\" rel=\"noopener\">Ordenanza Fiscal </a>');
INSERT INTO `wp_postmeta` VALUES (7109,1116,'_observaciones','<strong>Descripción del trámite:</strong>\n\nEl titular del inmueble deberá completar los formularios de solicitud de eximición y presentar la documentación requerida.\n\n<strong>¿Quién lo puede realizar?:</strong>\n<ul>\n 	<li>Entidades educativas públicas, nacionales y municipales</li>\n 	<li>Jubilados y pensionados</li>\n 	<li>Cuerpo de bomberos voluntarios del partido</li>\n 	<li>Veteranos de guerra y excombatientes de Malvinas</li>\n 	<li>Discapacitados, sus padres y tutores</li>\n 	<li>Asociaciones o instituciones de bien público, instituciones religiosas de todos los cultos reconocidos por el Ministerio de Relaciones Exteriores y Culto de la Nación</li>\n 	<li>Madres y/o víctimas de desaparición forzada por las fuerzas armadas con anterioridad al año 1983.</li>\n</ul>\n<strong>Costo del trámite:</strong>\n\n<a href=\"/boletin-oficial/\">SEGÚN ORDENANZA TARIFARIA Y FISCAL VIGENTE</a>');
