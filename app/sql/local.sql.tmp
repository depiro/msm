INSERT INTO `wp_postmeta` VALUES (6957,1109,'_observaciones','<strong>COSTO DE TRÁMITE:  </strong>Sin costo\n\n<strong>DESCRIPCIÓN DEL TRAMITE</strong>:\n\n1- Dirigirse a la dirección de Tasas de Servicios Municipales con el N° de la partida que desea consultar.\n\n2- Se verificará el estado de la Partida Municipal para la generación de la simulación de posibles planes de pago y la documentación requerida para el trámite  o se le imprimirán las boletas de pago según lo que desee.\n\n<strong>DOCUMENTO QUE SE OBTIENE: </strong>Formulario 15 con descripción de deuda discriminada por cuotas.');
