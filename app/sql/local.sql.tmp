INSERT INTO `wp_postmeta` VALUES (6907,1106,'_observaciones','<strong>QUIEN LO PUEDE REALIZAR:</strong>\n\nContribuyentes que posean comercios inscriptos en la tasa por inspección de seguridad e higiene\n\n<strong>DESCRIPCION DEL TRAMITE</strong>\n<ol>\n 	<li>Titular o responsable del comercio debe completar el <a href=\"/wp-content/uploads/2025/02/FORMULARIOS-DE-PEDIDO-DE-BAJA-RETROAC.pdf\">formulario/ solicitud de baja retroactiva</a>, indicando la fecha de cese.</li>\n 	<li>Una vez completo, presentar el formulario original y una copia, junto a un recibo de sellado para inicio de expediente en Tasas Generales.</li>\n 	<li>Iniciado el Expte. se gira a Inspecciones para verificar la fecha de cese, una vez informado se envía a la Dirección de Tasas Generales para la prosecución del trámite.</li>\n</ol>\nSe informará telefónicamente cuando el trámite esté en condiciones para proseguir, se deberá presentar en Cámara de Comercio la documentación requerida para realizar el\n\n<strong>COSTO:</strong>\n\n<a href=\"/boletin-oficial/\">SEGÚN ORDENANZA TARIFIARIA VIGENTE</a>\n\n&nbsp;');
INSERT INTO `wp_postmeta` VALUES (6908,1106,'_lugar_de_atencion','Presencial Dirección de Tasas Generales, Tasa por Inspección de Seguridad e Higiene, previa solicitud de nro. en INFORMES, Belgrano 1342');
