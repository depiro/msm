INSERT INTO `wp_postmeta` VALUES (10225,329,'_msm_sidebar_info','<p class=\"text-white mb-4 fs-6\">Tramitación y aprobación de permisos relacionados con construcciones, ampliaciones y demoliciones, asegurando el cumplimiento de las normativas municipales.</p>\r\n\r\n			<h5 class=\"text-acento fw-bold mb-2\">Horario de atención</h5>\r\n			<ul class=\"mb-4\">\r\n				<li class=\"small\">Lunes a Sábados de 8:00 a 14:00 hs.</li>\r\n			</ul>\r\n\r\n			<h5 class=\"text-acento fw-bold mb-2\">Contacto</h5>\r\n			<ul>\r\n				<li  class=\"small\"><strong>Teléfono:</strong> (11) 60917130 <strong>interno</strong> 6330</li>\r\n				<li  class=\"small\"><strong>Email:</strong> info.empleo@msm.gov.ar</li>\r\n				<li  class=\"small\"><strong>Instagram:</strong> <a href=\"https://www.instagram.com/obras_particulares/\" target=\"_blank\">obras_particulares</a></li>\r\n			</ul>\r\n');
INSERT INTO `wp_postmeta` VALUES (10226,329,'_msm_subtitulo','Gestionamos permisos y trámites para el desarrollo de obras en San Miguel.');
