INSERT INTO `wp_postmeta` VALUES (5494,1040,'observaciones','La empresa recolectora asignada entregará sin costo un recipiente para el almacenamiento transitorio del AVU para su retiro.\n\nDescripción del trámite:\n\n 	Ingresar a Encuesta y completar con todos los datos solicitados y enviar.\n 	Una vez recibido, se le enviará Numero Único de Generador y se lo contactará con la empresa recolectora de AVU que se encuentra habilitada para el retiro.\n\nCosto de trámite: Sin costo.\n\nDocumento que se obtiene: Constancia de Registro de Generador de AVU / Declaración Jurada de Establecimiento No Generador de AVU.\n\nQuien lo puede realizar: Comedores de hoteles, comedores escolares y de hospitales o establecimientos geriátricos, comedores comunitarios e industriales; Restaurantes, confiterías y bares, locales de comidas rápidas, rotiserías y todo establecimiento que genere residuos de aceites comestibles que han sufrido un tratamiento térmico de desnaturalización, todo el territorio del partido de San Miguel.\n\n&nbsp;');
INSERT INTO `wp_postmeta` VALUES (5495,1041,'ubicacion','');
INSERT INTO `wp_postmeta` VALUES (5496,1041,'direccion','');
INSERT INTO `wp_postmeta` VALUES (5497,1041,'localidad','');
INSERT INTO `wp_postmeta` VALUES (5498,1041,'telefono','');
INSERT INTO `wp_postmeta` VALUES (5499,1041,'horario_apertura','');
INSERT INTO `wp_postmeta` VALUES (5500,1041,'horario_cierre','');
INSERT INTO `wp_postmeta` VALUES (5501,1041,'atiende_24hs','no');
INSERT INTO `wp_postmeta` VALUES (5502,1041,'_presentacion_del_tramite','Registro basado en <a href=\"/boletin-oficial/\">Ordenanza 39/2012</a>, que tiene como fin regular y controlar que los únicos destinos del residuo sean el reciclaje, tratamiento, disposición final y/o transformación en biodiesel, evitando de esta manera la contaminación del medio ambiente y la recirculación de este residuo en el mercado alimenticio.');
INSERT INTO `wp_postmeta` VALUES (5503,1041,'_requisitos','<ul>\n 	<li>Formulario de Registro de Operadores de AVU Habilitado.</li>\n 	<li>Certificado de Aptitud Ambiental vigente</li>\n 	<li>Habilitación de Ministerio de Ambiente de la provincia de Buenos Aires para realizar la actividad de tratamiento del AVU y/o producción de biodiesel</li>\n 	<li>Habilitación Industrial del establecimiento donde se ejecutan las actividades de tratamiento de AVU</li>\n 	<li>Registro de tecnologías de RSU ante el Ministerio de Ambiente de la Provincia de Buenos Aires.</li>\n 	<li>Registro ante la Secretaría de Energía de la Nación (en caso de producir biodiesel)</li>\n 	<li>Informe técnico con descripción y material fotográfico del proceso de producción y tratamiento, características y condiciones del establecimiento para el almacenamiento de AVU, el tratamiento de los residuos y efluentes generados, la higienización, el lavado y la desinfección de los vehículos y planta, y las condiciones de seguridad.</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (5504,1041,'_duracion_del_tramite','Presentada toda la documentación necesaria, el trámite estará finalizado en un plazo máximo de 10 días hábiles.');
INSERT INTO `wp_postmeta` VALUES (5505,1041,'_vigencia_del_documento_obtenido','2 años.');
INSERT INTO `wp_postmeta` VALUES (5506,1041,'_respaldo_legal','Ordenanza <a href=\"/boletin-oficial/\">Municipal 39/2012.</a> Asimismo, la producción de biodiesel se encuentra regulada y promovida por: la Secretaría de Energía de la Nación mediante la Ley Nacional 27640 <a href=\"https://servicios.infoleg.gob.ar/infolegInternet/anexos/350000-354999/352587/norma.htm\">InfoLEG - Ministerio de Justicia y Derechos Humanos - Argentina</a>');
INSERT INTO `wp_postmeta` VALUES (5507,1041,'_observaciones','<strong>DESCRIPCIÓN DEL TRÁMITE:</strong>\n<ol>\n 	<li>Una vez que se cuente con la documentación necesaria, descargar <a href=\"/wp-content/uploads/2025/02/Formulario-Registro-de-Operadores.doc\">SECRETARÍA DE PLANEAMIENTO Y DESARROLLO URBANO SUBSECRETARÍA DE AMBIENTE</a></li>\n 	<li>Completar el formulario y solicitar un turno de atención enviando un correo electrónico a la siguiente dirección: <a href=\"mailto:ambiente@msm.gov.ar\" target=\"_blank\" rel=\"noopener\">ambiente@msm.gov.ar</a>.</li>\n 	<li>Presentarse en la oficina de la Subsecretaría de Ambiente en el día y horario indicado junto al formulario firmado y los originales y fotocopias de toda la documentación solicitada</li>\n</ol>\n<strong>¿Quíen lo puede realizar?</strong>\n\nTitular, Apoderado o Gestor designado de Operadores de Aceite Vegetal Usado, que procesen AVU proveniente de Empresas Transportistas habilitadas por el Municipio de San Miguel para su recolección.\n\n<strong>Documento que se obtiene</strong>\n\n: Constancia de Registro de Operadores de AVU Habilitado\n\n<strong>Costo del trámite:</strong>\n\nSin costo');
INSERT INTO `wp_postmeta` VALUES (5508,1041,'_lugar_de_atencion','Subsecretaría de Ambiente, sito en Domingo Faustino Sarmiento 1551, San Miguel');
INSERT INTO `wp_postmeta` VALUES (5509,1041,'_horarios_de_atencion','Lunes a viernes de 9hs a 16hs. Se requiere turno previo que debe ser solicitado enviando un correo electrónico a <a href=\"mailto:ambiente@msm.gov.ar\">ambiente@msm.gov.ar</a>');
