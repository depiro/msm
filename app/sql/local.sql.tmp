INSERT INTO `wp_postmeta` VALUES (6444,1086,'observaciones','Descripción del trámite:\n\n 	Ingresar a Portal de Tramites\n 	Dirigirse a la solapa que dice “Recursos Territoriales”.\n 	Seleccionar “Planchetas Municipales”.\n 	Seleccionar el Número de Manzana (circunscripción – sección – nro de manzana).\n 	Seleccionar “Aplicar”.\n 	(En caso de no conocer Número de Manzana, podrá ingresar en el buscador la dirección y podrá ver el nro que le corresponde).\n\nDocumento que se obtiene:\n\nPlancheta digital o en mano.\n\n¿Quién lo puede realizar?:\n\nContribuyente o profesionales en general.\n\nDocumento que se obtiene:\n\nPlancheta digital o en mano.\n\n¿Cómo recibo el resultado del trámite?:\n\nEl titular recibirá plancheta en mano o se puede descargar por la página.\n\nCosto del trámite:\n\nSegún tarifaria y fiscal\n\n&nbsp;');
