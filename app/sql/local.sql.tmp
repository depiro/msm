INSERT INTO `wp_postmeta` VALUES (6627,1094,'_presentacion_del_tramite','En caso de querer realizar un trabajo en la vía pública relacionado con la infraestructura de los servicios públicos, debe presentarse en la Dirección General de Infraestructura dependiente de la Subsecretaría de Servicios Concesionados y solicitar el permiso que lo habilita para realizar la obra.');
INSERT INTO `wp_postmeta` VALUES (6628,1094,'_requisitos','<ol>\n 	<li>Proyecto del tendido a ejecutar.</li>\n 	<li>Contrato de tareas profesionales.</li>\n 	<li>Copia de Certificado de capacidad técnica/financiera.</li>\n 	<li>Presupuesto de obra con IVA incluido.</li>\n 	<li>Cronograma de Trabajos.</li>\n 	<li>Pago de Derecho Municipales.</li>\n 	<li>Interferencias de servicios.</li>\n 	<li>Representante por parte de la empresa, denominación social, domicilio real y legal constituido dentro del partido de San Miguel. Acreditar la representación que invoca.</li>\n 	<li>Contacto del representante.</li>\n</ol>');
INSERT INTO `wp_postmeta` VALUES (6629,1094,'_duracion_del_tramite','Si presenta toda la documentación completa inicialmente, el trámite demora 3 semanas.');
INSERT INTO `wp_postmeta` VALUES (6630,1094,'_vigencia_del_documento_obtenido','El tiempo que dure la obra de acuerdo al cronograma aprobado.');
INSERT INTO `wp_postmeta` VALUES (6631,1094,'_respaldo_legal','<ul>\n 	<li>Ordenanza 675/89 Trabajo en vía pública.</li>\n 	<li>Ordenanza Tarifaria y Fiscal vigente</li>\n 	<li>Reglamento AEA (Asociación Electrotécnica Argentina)</li>\n 	<li> <a href=\"http://servicios.infoleg.gob.ar/infolegInternet/anexos/15000-19999/17612/norma.htm#:~:text=EL%20PRESIDENTE%20DE%20LA%20NACION,en%20su%20consecuencia%20se%20dicten.\" target=\"_blank\" rel=\"noopener\">Ley de Seguridad e Higiene.</a></li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (6632,1094,'_observaciones','En caso de obras de Telecomunicaciones se le transfiere a la Subsecretaría de Modernización.\n\n<strong>Descripción del trámite:</strong>\n<ol>\n 	<li>Presentarse en la Dirección General de Infraestructura donde se obtendrá un Sellado para dar inicio al trámite.</li>\n 	<li>Con toda la documentación requerida y el comprobante de pago del Sellado, se deberá iniciar el expediente en la Mesa de Entradas de la Municipalidad.</li>\n 	<li>El expediente será evaluado por la Dirección General de Infraestructura, quien se comunicará con la persona de contacto declarada por cualquier duda o requerimiento adicional y avisará cuando esté finalizado el Permiso para ser retirado.</li>\n 	<li>Para retirar el Permiso debe presentarse en la Dirección Gral. de Infraestructura donde se obtendrá la boleta para realizar el pago de los Derechos Municipales, en caso de corresponder de acuerdo a la obra.</li>\n 	<li>Realizado el pago se le entregará el Permiso que habilita el inicio de las tareas.</li>\n</ol>\n<strong>Documento que se obtiene:</strong>\n\nPermiso de trabajo en la Vía Publica.\n\n<strong>¿Quién lo puede realizar?:</strong>\n\nEmpresas de servicios públicos y empresas de infraestructura asociadas a servicios públicos.\n\n<strong>¿Cómo recibo el resultado del trámite?:</strong>\n\nSe retira presencialmente.\n\n<strong>Costo del trámite:</strong>\n\nInicio un expediente $300.30 Obras contratadas por el Estado Municipal 0% Obras contratadas por empresas de servicios públicos aéreo 3% Obras contratadas por empresas de servicios públicos soterrado 0% Obras contratadas por organismos públicos, provinciales o nacionales 0%.\n\n&nbsp;\n\n&nbsp;');
INSERT INTO `wp_postmeta` VALUES (6633,1094,'_lugar_de_atencion','Secretaría de Obras Publicas Dirección Gral. de Infraestructura');
INSERT INTO `wp_postmeta` VALUES (6634,1094,'_horarios_de_atencion','Lunes a viernes de 8 a 14 hs,');
