INSERT INTO `wp_postmeta` VALUES (4825,998,'_presentacion_del_tramite','Solicitud de artistas locales para la utilización del espacio, caracterizado por el cobro de entradas. Del total recaudado, se abona un 25% de acuerdo a lo pactado en la ordenanza Municipal.');
INSERT INTO `wp_postmeta` VALUES (4826,998,'_requisitos','<ol>\n 	<li>Registrarse en <a href=\"https://docs.google.com/forms/d/e/1FAIpQLScwgQY71Io3rzeXnHhA02utm4gwLMThSR4pWPRPkL3skZ0PoA/viewform\" target=\"_blank\" rel=\"noopener\">RUAL</a></li>\n 	<li>Solicitar el formulario para la utilización del espacio</li>\n</ol>');
INSERT INTO `wp_postmeta` VALUES (4827,998,'_duracion_del_tramite','');
INSERT INTO `wp_postmeta` VALUES (4828,998,'_vigencia_del_documento_obtenido','Hasta la finalización del evento.');
INSERT INTO `wp_postmeta` VALUES (4829,998,'_respaldo_legal','');
INSERT INTO `wp_postmeta` VALUES (4830,998,'_observaciones','<strong>Descripción del trámite:</strong>\n<ol>\n 	<li>Registrarse en RUAL (<a href=\"https://docs.google.com/forms/d/e/1FAIpQLScwgQY71Io3rzeXnHhA02utm4gwLMThSR4pWPRPkL3skZ0PoA/viewform\" target=\"_blank\" rel=\"noopener\">Registro Único de Artistas Locales</a>)</li>\n 	<li>Contactarse de manera presencial o virtual con cualquiera de los espacios dispuestos.</li>\n 	<li>Previo al evento completar la primera parte de la Declaración Jurada</li>\n 	<li>Realización del evento</li>\n 	<li>Finalizado el evento, completar la última parte de la Declaración Jurada</li>\n 	<li>Abonar el 25% en Dirección General de Habilitaciones (Av. Balbín 1229 1° Piso) (7 días para pagar la tasa de borderaux).</li>\n</ol>\n<strong>Documento que se obtiene:</strong>\n\nFotocopias de toda la documentación presentada, sellada por Cultura como constancia de confirmación del evento.\n\n<strong>¿Quién lo puede realizar?</strong>\n\nArtistas locales registrados en RUAL.\n\n<strong>Costo del trámite:</strong>\n\nSin costo');
INSERT INTO `wp_postmeta` VALUES (4831,998,'_lugar_de_atencion','<ul>\n 	<li>Fábrica del Arte (Jose J. Paso 1300)</li>\n 	<li>Teatro Marechal (Charlone 1146), San Miguel</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (4832,998,'_horarios_de_atencion','Lunes a Viernes de 08.30 a 16.30hs');
