INSERT INTO `wp_postmeta` VALUES (6177,1076,'_presentacion_del_tramite','Cuando se quiera realizar la extracción o recambio de un Sistema de Almacenaje Subterráneo de Hidrocarburos (SASH) o sus cañerías subterráneas se deberá obtener previamente el Permiso Municipal de extracción o recambio de SASH. Para esto se deberá presentar ante la autoridad ambiental municipal el proyecto de obra, junto a documentación requerida por normativa nacional y provincial e información ambiental del sistema, a fin de evaluar el impacto sobre el suelo y acuíferos y determinar los condicionamientos necesarios para la ejecución de la obra.');
INSERT INTO `wp_postmeta` VALUES (6178,1076,'_requisitos','<ol>\n 	<li>Nota de Solicitud de Permiso, indicando razón social y ubicación del establecimiento, empresa habilitada</li>\n 	<li>Constancia de inicio de expediente habilitación en la Subsecretaria de Energía</li>\n 	<li>Constancia de inicio de expediente de Plan de Trabajo en el Organismo Provincial Para el Desarrollo Sostenible (OPDS)</li>\n 	<li>Copia del proyecto del Plan de trabajo presentado en OPDS por la empresa responsable de realizar el recambio de tanques.</li>\n 	<li>Póliza de Seguro Ambiental vigente.</li>\n 	<li>Certificado de protección catódica vigente.</li>\n 	<li>Plano de ubicación de tanques y de la red de cañerías.</li>\n 	<li>Plano de pozos de monitoreo y sensores instalados</li>\n 	<li>Prueba de hermeticidad de SASH existente.</li>\n 	<li>Estudio hidrológico y del Suelo firmado por profesional idóneo en la materia.</li>\n 	<li>En el caso que quien presente el trámite sea un apoderado, deberá adjuntar el poder que lo habilita.</li>\n</ol>');
INSERT INTO `wp_postmeta` VALUES (6179,1076,'_duracion_del_tramite','Si no se materializó esa extracción dentro de los 240 días, se debe realizar nuevamente el trámite de solicitud.');
INSERT INTO `wp_postmeta` VALUES (6180,1076,'_vigencia_del_documento_obtenido','Si no se materializó esa extracción dentro de los 240 días, se debe realizar nuevamente el trámite de solicitud.');
INSERT INTO `wp_postmeta` VALUES (6181,1076,'_respaldo_legal','<ul>\n 	<li>Ley Provincial 11.720 de Residuos Especiales</li>\n 	<li>Ley Provincial 11.723</li>\n 	<li>Resolución OPDS N° 94/14</li>\n 	<li>Resoluciones de la Secretaria de Energía 404/94, 785/05 y 1102/04</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (6182,1076,'_observaciones','<strong>Documento que se obtiene: </strong>Permiso de extracción o recambio de SAHS.\n\n<strong>Descripción del tramite:</strong>\n<ol>\n 	<li>Solicitar información a la dirección de correo electrónico evaluación.ambiental@msm.gov.ar o por teléfono al 6091-7100 interno 6132.</li>\n 	<li>Solicitar el inicio de expediente ante la Dirección de Evaluación y Control Ambiental (DEyCA).</li>\n 	<li>Presentar los requisitos mínimos solicitados ante la DEyCA.</li>\n 	<li>Finalizada la evaluación técnica de la documentación solicitada, y previo a la emisión del Permiso, se deberá abonar la Tasa de Aptitud Ambiental conforme a la Ordenanza Fiscal y Tarifaria del año en curso.</li>\n 	<li>Una vez realizado el pago de la tasa se emitirá el Permiso solicitado en un plazo máximo de 15 días hábiles.</li>\n</ol>\n<strong>Quien lo puede realizar:</strong> Personas físicas o jurídicas titulares de establecimientos que posean y deban realizar extracción o recambio de SASH o empresas habilitadas por el Ministerio de Ambiente de la Provincia de Buenos Aires para prestar el servicio de extracción, tratamiento y disposición final de los mismos.\n\n<strong>¿Cómo recibo el trámite?:</strong> Una vez obtenido los permisos y constancia de parte de la Autoridad de Aplicación provincial favorables, más la copia de documentación avalatoria de dicho trámite, el municipio otorga el Permiso de Extracción o Recambio de SASH. Finalizadas las obras y analizada la documentación de los condicionamientos establecidos, se otorgará la Constancia de Finalización de Extracción o Recambio de SASH.\n\n<strong>Organismo responsable:</strong> Ministerio de Ambiente de la PBA. Subsecretaría de Ambiente.\n\n<strong>Costo: </strong>\n\n<strong><a href=\"/boletin-oficial/\">Según ordenanza vigente</a></strong>');
INSERT INTO `wp_postmeta` VALUES (6183,1076,'_lugar_de_atencion','Subsecretaría de Ambiente, Domingo Faustino Sarmiento 1551, San Miguel.');
INSERT INTO `wp_postmeta` VALUES (6184,1076,'_horarios_de_atencion','Lunes a viernes de 9hs a 14hs, con turno previo, solicitándolo al mail <a href=\"mailto:industrias@msm.gov.ar\">industrias@msm.gov.ar</a> o por tel 6091-7100 int 6132/6133');
