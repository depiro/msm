INSERT INTO `wp_postmeta` VALUES (6652,1095,'_presentacion_del_tramite','Acompañamiento del adulto para finalizar los Estudios Primarios/Secundarios, facilitándoles útiles escolares y al finalizar ambos trayectos, se brindan Capacitaciones para oficios.');
INSERT INTO `wp_postmeta` VALUES (6653,1095,'_requisitos','<ol>\n 	<li>FINES TRAYECTO PRIMARIO: Sólo DNI</li>\n 	<li>FINES TRAYECTO SECUNDARIO: Fotocopia de DNI – constancia de alumno regular – Partida de nacimiento</li>\n 	<li>UNIDAD DE CAPACITACIÓN DE POTENCIAR TRABAJO: Fotocopia de DNI y constancia de CUIL</li>\n</ol>');
INSERT INTO `wp_postmeta` VALUES (6654,1095,'_duracion_del_tramite','En el momento.');
INSERT INTO `wp_postmeta` VALUES (6655,1095,'_vigencia_del_documento_obtenido','Hasta que se genere una modificación considerable en los procesos productivos de la industria, o haya cambio de rubro.');
INSERT INTO `wp_postmeta` VALUES (6656,1095,'_respaldo_legal','');
INSERT INTO `wp_postmeta` VALUES (6657,1095,'_observaciones','<strong>Descripción del trámite:</strong>\n\nAcercarse a la Escuela Primaria N°1 (Av. Balbín 1254) con la documentación solicitada.\n\n<strong>Documento que se obtiene:</strong>\n\nConstancia de Inscripción.\n\n<strong>¿Quién lo puede realizar?:</strong>\n\nDestinado a adultos mayores de 18 años, sin límite de edad.\n\n<strong>¿Cómo reciboe el resultado del trámite?:</strong>\n\nConfirmación vía mail.\n\n<strong>Costo del trámite:</strong>\n\nSin costo.');
INSERT INTO `wp_postmeta` VALUES (6658,1095,'_lugar_de_atencion','Para Fines Trayecto Primario, acércate a la Escuela Primaria N°1 Para Unidad de Capacitaciones en Oficios, acércate a la sede de Club Vicentinos (Av. Primera Junta 3150)');
