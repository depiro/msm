INSERT INTO `wp_postmeta` VALUES (7487,1180,'_presentacion_del_tramite','Este trámite se realiza cuando el titular de un comercio ha <strong>extraviado</strong> su <strong>Certificado de Habilitación</strong> y necesita solicitar un duplicado del mismo. La solicitud se realiza de forma <strong>presencial</strong>.');
INSERT INTO `wp_postmeta` VALUES (7488,1180,'_requisitos','<ol>\n 	<li><strong>Resolución de Habilitación</strong> o <strong>Foto del Certificado de Habilitación original</strong>.</li>\n 	<li><strong>Contrato de Locación</strong>, <strong>Comodato</strong>, o <strong>Boleto de Compra Venta</strong>.</li>\n 	<li><strong>Nota de solicitud</strong>.</li>\n 	<li><strong>Fotocopia del DNI</strong>.</li>\n</ol>');
