INSERT INTO `wp_postmeta` VALUES (7137,1131,'_presentacion_del_tramite','El trámite de Habilitación Comercial Precaria tiene como objetivo permitir al contribuyente realizar actividades comerciales cumpliendo los requisitos establecidos en el Decreto Nº 239/96.\nLa habilitación se otorga en función del Plano Catastral de Zonificación de la Municipalidad de San Miguel.\n\nPasos a seguir:\n<ol>\n 	<li>Presentar la documentación requerida en la oficina de Sarmiento 1686.</li>\n 	<li>Coordinar una inspección para que el inspector municipal visite el comercio.</li>\n 	<li>Una vez realizada la inspección, se enviará al contribuyente el número de expediente mediante el WhatsApp de Ayuda en Línea.</li>\n 	<li>Con el número de expediente, dirigirse a Tasas Comerciales en Sarmiento 1550 (de 8:00 a 14:00 hs) para solicitar la chequera de pago mensual.</li>\n 	<li>Tras registrar el pago, se emitirá el Certificado de Habilitación Precaria.</li>\n</ol>');
INSERT INTO `wp_postmeta` VALUES (7138,1131,'_requisitos','<ul>\n 	<li>Documento Nacional de Identidad (DNI).</li>\n 	<li>Contrato de Comodato o documento que acredite el uso del inmueble.</li>\n 	<li>Copia de un servicio a nombre del solicitante (luz, agua o gas).</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (7139,1131,'_duracion_del_tramite','24 horas hábiles.');
INSERT INTO `wp_postmeta` VALUES (7140,1131,'_vigencia_del_documento_obtenido','El Certificado de Habilitación Precaria tiene una validez de 1 año desde la fecha de emisión. Para renovarlo, el solicitante debe acercarse nuevamente a la oficina de Sarmiento 1686.');
INSERT INTO `wp_postmeta` VALUES (7141,1131,'_respaldo_legal','Ordenanza Municipal: Decreto 239 y Ordenanza 618/86.');
INSERT INTO `wp_postmeta` VALUES (7142,1131,'_observaciones','Para consultas o asesoramiento, comunicarse al WhatsApp de Ayuda en Línea: 11-3884-9649.');
