INSERT INTO `wp_postmeta` VALUES (7717,1250,'_observaciones','1 año, para mantenerla se debe presentar una DDJJ todos los años.\n\n<strong>Descripción del trámite:</strong>\n\nPresentarse en la oficina con la documentación requerida.\n\n<strong>¿Quién lo puede realizar?:</strong>\n\nMonotributistas Sociales y Monotributistas hasta la categoría D (excepto profesionales).\n\n<strong>Documento que se obtiene:</strong>\n\nExención de pago de IIBB.\n\n<strong>Costo del trámite:</strong>\n\nSin Costo');
