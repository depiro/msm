INSERT INTO `wp_postmeta` VALUES (6219,1077,'observaciones','Descripción del trámite:\n\n 	El profesional actuante deberá estar matriculado en el Colegio Profesional de la Pcia. de Bs. As. inscripto en el Registro Municipal de Profesionales Ambientales.\n 	Contar con los Requisitos para realizar el Relevamiento Arbóreo, según el tipo de espacio y proyecto.\n 	Realizar un Plano de Relevamiento Arbóreo y/o Informe Técnico según corresponda, visado por el colegio profesional.\n\nDocumento que se obtiene:\n\nNota de conformidad al proyecto con los condicionantes a cumplir y el visado final del Plano de Arbolado.\n\n¿Quién lo puede realizar?:\n\nTitular de las parcelas involucradas o profesional encargado de la tramitación de Planos de Mensura, Planos de Obra, Permiso de Demolición o Excavación, o Consulta Técnica de Conformidad, ubicados en Espacios Ecológicamente Protegidos o impliquen proyectos de emprendimientos comerciales, industriales o de conjunto de viviendas.\n\nCosto del trámite:\n\nSin costo.');
