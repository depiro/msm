INSERT INTO `wp_postmeta` VALUES (5202,1027,'_presentacion_del_tramite','La renovación de la habilitación de Transporte Escolar es la continuidad del trámite de habilitación, el cual es un requisito de la Municipalidad de San Miguel para poder ejercer la actividad de transportista en los colegios del partido.');
INSERT INTO `wp_postmeta` VALUES (5203,1027,'_requisitos','<strong>En caso de ser titular del vehículo y también lo conducirlo, o si posee chofer:</strong>\r\n<ol>\r\n 	<li>D.N.I. hoja 1,2 y cambio de domicilio (si hay)</li>\r\n 	<li>Licencia de Conducir con Categoría Habilitante.</li>\r\n 	<li>Libreta Sanitaria</li>\r\n 	<li>Certificado de Antecedentes Penales</li>\r\n</ol>\r\n<strong>También se necesitará de celador que esté acompañando a los chicos en el viaje:</strong>\r\n<ol>\r\n 	<li>D.N.I. hoja 1,2 y cambio de domicilio (si hay).</li>\r\n 	<li>Libreta Sanitaria</li>\r\n 	<li>Certificado de Antecedentes Penales</li>\r\n</ol>\r\n<strong>Del Vehículo a habilitar:</strong>\r\n<ol>\r\n 	<li>Que no sea furgón.</li>\r\n 	<li>Antigüedad máxima 20 años.</li>\r\n 	<li>Título del automotor.</li>\r\n 	<li>Cédula Verde.</li>\r\n 	<li>Recibo de pago de Patente.</li>\r\n 	<li>Póliza de Seguro: Escolar o Servicio Especial.</li>\r\n 	<li>Recibo de pago de Seguro.</li>\r\n 	<li>VTV</li>\r\n 	<li>Cédula</li>\r\n 	<li>Planilla</li>\r\n 	<li>Libre deuda de infracciones de Tránsito Municipal.</li>\r\n</ol>\r\n(Llevar vehículo a la Dirección de Transporte para una inspección técnica) (Documentación original)');
INSERT INTO `wp_postmeta` VALUES (5204,1027,'_duracion_del_tramite','<span style=\"font-weight: 400\">Una vez cargada la documentación correspondiente en un plazo máximo de 72hs ya tienen la habilitación a su disposición. </span>');
INSERT INTO `wp_postmeta` VALUES (5205,1027,'_vigencia_del_documento_obtenido','La habilitación estará vigente durante todo el año escolar.');
INSERT INTO `wp_postmeta` VALUES (5206,1027,'_respaldo_legal','Ordenanza de Transporte 33/14 <a href=\"/boletin-oficial/\">Ordenanza Tarifaria y Fiscal Municipal.</a> Art 55° Ley Nacional de Tránsito y Seguridad Vial (24.449) Disposiciones Provinciales');
INSERT INTO `wp_postmeta` VALUES (5207,1027,'_observaciones','Se deberá realizar la Desinfección de la unidad mensualmente en empresas habilitadas por Medicina Preventiva.\r\n\r\n<strong>Descripción del trámite:</strong>\r\n<ol>\r\n 	<li>Dirigirse a la oficina de Transporte, con toda la documentación requerida vigente del vehículo, del titular, chofer (si tuviere) y del celador. También llevar el vehículo a habilitar.</li>\r\n 	<li>Una vez completa por única vez la Solicitud de Autorización para Habilitar Transporte, se debe entregar la documentación presentada al personal de Transporte, y se llevará a cabo la Inspección Técnica Municipal del vehículo a habilitar. Luego de aprobar esta última, se designará un número de interno que debe colocarlo en el exterior del vehículo.</li>\r\n 	<li>Con la documentación y la revisión técnica aprobada, el personal administrativo confeccionará una Orden de Emisión de Recibo, y con el mismo se emitirá una boleta para el pago del Inicio de Trámite, la Habilitación y la Inspección Técnica Municipal.</li>\r\n 	<li>Ya con el recibo en mano, dirigirse a las cajas municipales (ubicadas en planta baja del Palacio Municipal), a un Rapipago o a un Pago Fácil para para abonar la boleta.</li>\r\n 	<li>Regresar a la Oficina de Transporte, presentar el original del pago efectuado (el cual se anexará al expediente de habilitación). Con el pago recibido, el trámite de habilitación está casi terminado. El personal de Transporte completará la Habilitación de Transporte Escolar, y será girada a la Dirección General de Tránsito y Transporte para ser aprobada finalmente por el Director.</li>\r\n 	<li>Una vez que esté todo completo, se comunicará telefónicamente cuando se puede pasar por la Oficina a retirar la Habilitación de Transporte Escolar, la cual tendrá vigencia por la totalidad del año escolar.</li>\r\n 	<li>Deberá acercarse con el vehículo para que el personal fije los Logos Identificatorios, los cuales se identifican con un número de interno.</li>\r\n</ol>\r\n<strong>Documento que se obtiene:</strong>\r\n\r\nHabilitación de Transporte Escolar, la cual cuenta con los datos del vehículo, del titular, chofer y celador.\r\n\r\n<strong>¿Quién lo puede realizar?:</strong>\r\n\r\nVecinos que necesiten renovar la habilitación de transporte escolar para trabajar en colegios del Partido de San Miguel. En caso de no haber habilitado un vehículo en años anteriores, deberá buscar el trámite de Inicio de trámite de habilitación de Transporte escolar.\r\n\r\n<strong>¿Cómo recibo el resultado del trámite?:</strong>\r\n\r\nMediante llamado telefónico.\r\n\r\n<strong>Costo del trámite:</strong>\r\n\r\n$ 1949,20');
INSERT INTO `wp_postmeta` VALUES (5208,1027,'_lugar_de_atencion','Oficina de Transporte Italia y las vías del FFCC San Martín.');
INSERT INTO `wp_postmeta` VALUES (5209,1027,'_horarios_de_atencion','Lunes a Viernes, de 08:00 a 12:30 hs, sin turno previo.');
