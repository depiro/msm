INSERT INTO `wp_postmeta` VALUES (6251,1079,'atiende_24hs','no');
INSERT INTO `wp_postmeta` VALUES (6252,1079,'_presentacion_del_tramite','La oficina de empleo municipal gestiona búsquedas laborales de comercios e industrias locales. Es para aquellos que estén interesados en que se tenga en cuenta su perfil, para las próximas búsquedas. La inscripción al servicio consta de una entrevista para conocer el perfil ocupacional y de esta manera determinar para qué tipo de búsquedas hay que contactarse. El servicio se llama intermediación laboral, porque la oficina de empleo actúa de intermediaria y nexo entre las empresas locales que tienen puestos de trabajo vacantes y los vecinos del partido que se encuentra en búsqueda de empleo.');
INSERT INTO `wp_postmeta` VALUES (6253,1079,'_requisitos','<ol>\n 	<li>DNI, el cual certifique residencia en el partido de San Miguel y ser mayor de 18 años.</li>\n 	<li>En caso de contar con CV, traerlo.</li>\n 	<li>Si el DNI está desactualizado, se puede traer un servicio a nombre propio y/ o constancia, otorgada por registro civil que confirmen la dirección.</li>\n</ol>');
INSERT INTO `wp_postmeta` VALUES (6254,1079,'_duracion_del_tramite','Si se cuenta con CV, el registro al servicio de intermediación laboral lleva de 20 a 30 minutos. Sino, el registro puede llegar a tardar 45 minutos aproximadamente.');
INSERT INTO `wp_postmeta` VALUES (6255,1079,'_vigencia_del_documento_obtenido','Un año. Pero se puede registrar y actualizar los datos las veces que el interesado, considere necesario.');
INSERT INTO `wp_postmeta` VALUES (6256,1079,'_respaldo_legal','');
INSERT INTO `wp_postmeta` VALUES (6257,1079,'_observaciones','<strong>Descripción del trámite:</strong>\n\nSacar turno llamando al: 6091-7100 INT 6530  o bien, mandando un mail a <a href=\"mailto:info.empleo@msm.gov.ar\">info.empleo@msm.gov.ar</a>\n\n<strong>Documento que se obtiene:</strong>\n\nConstancia de registro al servicio de intermediación laboral.\n\n<strong>¿Quién lo puede realizar?:</strong>\n\nVecinos del partido de San Miguel, mayores de 18 años.\n\n<strong>Costo del trámite:</strong>\n\nSin costo.');
INSERT INTO `wp_postmeta` VALUES (6258,1079,'_lugar_de_atencion','Oficina de empleo, Av. R Balbin, entre L. Alem y D.F Sarmiento.');
INSERT INTO `wp_postmeta` VALUES (6259,1079,'_horarios_de_atencion','Lunes a viernes 08 a 14hs Tel. 6100-7100 INT: 30/31 E-mail: <a href=\"mailto:info.empleo@msm.gov.ar\">info.empleo@msm.gov.ar</a>');
