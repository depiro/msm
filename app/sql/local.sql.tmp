INSERT INTO `wp_postmeta` VALUES (6577,1092,'_presentacion_del_tramite','El objetivo del trámite es informar al solicitante la deuda de la TSM');
INSERT INTO `wp_postmeta` VALUES (6578,1092,'_requisitos','<ol>\n 	<li>Formulario A901 – 903 o el que corresponda al tipo de propiedad.</li>\n 	<li>Cédula Catastral de ARBA con superficie edificada en parcela (valuación actualizada).</li>\n 	<li>En caso de unidades funcionales, subdivisiones o unificaciones, los planos deberán contar con vigencia administrativa (excluyente).</li>\n 	<li>El escribano deberá estar registrado en la base de datos del municipio.</li>\n</ol>');
INSERT INTO `wp_postmeta` VALUES (6579,1092,'_duracion_del_tramite','5 días hábiles aproximadamente');
INSERT INTO `wp_postmeta` VALUES (6580,1092,'_vigencia_del_documento_obtenido','30 días.');
INSERT INTO `wp_postmeta` VALUES (6581,1092,'_respaldo_legal','<a href=\"/boletin-oficial/\">ORDENANZA TARIFARIA Y FISCAL VIGENTE</a>');
INSERT INTO `wp_postmeta` VALUES (6582,1092,'_observaciones','<strong>Descripción del trámite:</strong>\n<ol>\n 	<li>Ingresar a <a href=\"https://ventanillaunica.msm.gov.ar/Account/Login\">Portal de Trámites.</a></li>\n 	<li>Iniciar sesión con clave AFIP/ANSES y seguir los pasos.</li>\n</ol>\n<strong>Documento que se obtiene:</strong>\n\nCertificado informado por la Dirección de Recursos Tributario la deuda de la TSM\n\n<strong>¿Quién lo puede realizar?:</strong>\n\nEscribanías\n\n<strong>¿Cómo recibo el resultado del trámite?:</strong>\n\nEl titular recibirá los resultados en forma de documentos adjuntos a través de la web.\n\n<strong>Costo del trámite:</strong>\n\n<a href=\"/boletin-oficial/\">SEGÚN ORDENANZA TARIFARIA Y FISCAL VIGENTE</a>\n\n&nbsp;');
