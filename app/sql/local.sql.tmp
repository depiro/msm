INSERT INTO `wp_postmeta` VALUES (7096,1115,'observaciones','Descripción del trámite:\n\n 	Presentar formulario con todos los datos completos para verificar si los montos abonados son correctos.\n 	Luego de presentado el formulario, se verifican los datos y si está todo correcto, se le entrega copia sellada.\n 	En caso de existir diferencia, el agente procederá a la liquidación correspondiente.\n\nDocumento que se obtiene:\n\nCopia sellada y firmada por el Agente que la recepciona, y la misma puede ser utilizada para realizar los diversos trámites relacionados al comercio.\n\n¿Quén lo puede realizar?:\n\nContribuyentes que posean comercios inscriptos en TSH y PyP\n\nCosto del trámite:\n\nSin costo.');
