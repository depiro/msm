INSERT INTO `wp_postmeta` VALUES (7766,1254,'_respaldo_legal','Resolución 231/2016 (reglas de accesibilidad): <a href=\"https://normas.gba.gob.ar/documentos/0vvjJjCe.html\" target=\"_blank\" rel=\"noopener\">https://normas.gba.gob.ar/documentos/0vvjJjCe.html</a> Información general sobre el Pase Provincial de Transporte y otras resoluciones: <a href=\"https://www.gba.gob.ar/transporte/normativa\" target=\"_blank\" rel=\"noopener\">https://www.gba.gob.ar/transporte/normativa</a>');
INSERT INTO `wp_postmeta` VALUES (7767,1254,'_observaciones','<strong>Pasos a seguir:</strong>\n<ol>\n 	<li>Ingresar en el siguiente link y gestionar la solicitud: <a href=\"https://www.gba.gob.ar/transporte/accesibilidad/pase_libre_multimodal\">https://www.gba.gob.ar/transporte/accesibilidad/pase_libre_multimodal</a></li>\n</ol>\n<ol start=\"2\">\n 	<li>Acercarse con esa solicitud en 3 meses o más, a la oficina de atención para retirar el pase.</li>\n</ol>\n<strong>¿Cómo recibo el trámite?:</strong>\n\nSe retira por la oficina de atención.');
