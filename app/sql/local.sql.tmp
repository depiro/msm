INSERT INTO `wp_postmeta` VALUES (4901,1011,'_requisitos','<ol>\n 	<li>Formulario de solicitud de autorización actividades campamentiles con pernocte completo con la firma de un responsable de la Institución.</li>\n 	<li>Si se trata de una solicitud para una actividad escolar deberá presentar también la autorización de la autoridad escolar correspondiente.</li>\n</ol>');
INSERT INTO `wp_postmeta` VALUES (4902,1011,'_duracion_del_tramite','A partir de la presentación del formulario de solicitud completo, 48.00 hs. Luego deberá presentar la autorización de la autoridad escolar correspondiente.');
