INSERT INTO `wp_postmeta` VALUES (7737,1251,'_presentacion_del_tramite','Es un documento público y gratuito que certifica la discapacidad en todo el territorio argentino. Te lo otorgan luego de una evaluación que hace una junta formada por profesionales de distintas disciplinas.');
INSERT INTO `wp_postmeta` VALUES (7738,1251,'_requisitos','<ol>\n 	<li>Formularios completos, correspondientes a la patología que presenta el titular.</li>\n 	<li>Planilla de requisitos obligatoria.</li>\n 	<li>D.N.I. vigente del titular. En caso de ser menor, D.N.I. vigente, también, de padre/madre/tutor.</li>\n 	<li>En caso de que el titular esté judicializado, presentar documentación que lo avale.</li>\n</ol>');
INSERT INTO `wp_postmeta` VALUES (7739,1251,'_duracion_del_tramite','Una vez que la persona retira las planillas y pueda conseguir los turnos médicos para completarlas, se tarda un máximo de tres meses en conseguir el turno con la Junta Evaluadora y culminar el trámite.');
INSERT INTO `wp_postmeta` VALUES (7740,1251,'_vigencia_del_documento_obtenido','La vigencia depende de las secuelas que presente el titular del trámite en cuanto a su patología, rigiéndose su calificación por las normativas de cada tipo de discapacidad vigentes');
INSERT INTO `wp_postmeta` VALUES (7741,1251,'_respaldo_legal','Las normativas que rigen sobre la obtención del Certificado Único de Discapacidad, según los distintos tipos de discapacidad, figuran en opción de “Descargar archivo” del lado derecho de la página web adjuntada:\n\n<a href=\"https://www.argentina.gob.ar/como-obtener-el-certificado-unico-de-discapacidad-cud\">https://www.argentina.gob.ar/como-obtener-el-certificado-unico-de-discapacidad-cud</a>');
INSERT INTO `wp_postmeta` VALUES (7742,1251,'_observaciones','La renovación del CUD, ya sea por extravío, reagravamiento o primera vez; se realiza en la oficina de atención de lunes a viernes de 08.00hs a 14.00hs. La solicitud de Pase Provincial de Transporte y el C.M.O digitalizado se tramita de manera presencial en la oficina de atención. En caso de que el trámite haya sido denegado en la Junta Evaluadora Integral, por normativa vigente, quien se presente podrá contar con una segunda o hasta tercera instancia de validación, si así lo requiere, en los municipios asignados para tal fin. En cuanto a la exención de impuestos y/o patentes municipales, se realizan por ventanilla de Tasas Municipales, dentro del municipio, tramitando un expediente. El resto de tramitaciones digitales, de tipo peajes, símbolo de automotor, etc., corren por cuenta del usuario a través de la Aplicación Mi Argentina.\n\n<strong>Descripción del trámite:</strong>\n<ol>\n 	<li>Solicitar vía mail los formularios correspondientes a la patología existente, y la planilla de requisitos obligatoria. Enviando mail a <a href=\"mailto:Direccion.Discapacidad@msm.gov.ar\">Direccion.Discapacidad@msm.gov.ar</a></li>\n 	<li>Completar y presentar dichos formularios en la oficina de atención.</li>\n</ol>\nPresentar la planilla de requisitos obligatoria, con la documentación que ésta solicita.\n\n<strong>Documento que se obtiene:</strong>\n\nCertificado Único De Discapacidad.\n\n<strong>¿Cómo recibo el resultado del trámite?:</strong>\n\nUna vez solicitado el turno para Junta Evaluadora, presentando toda la documentación solicitada, se le informará el mismo día del turno cuándo retirar el Certificado Único de Discapacidad.\n\n<strong>Trámites relacionados:</strong>\n\nPase para transportes; símbolo nacional de accesibilidad; asignaciones relacionadas; eximición de tasas e impuestos.\n\n<strong>Costo del trámite:</strong>\n\nGratuito\n\n&nbsp;\n\n&nbsp;');
INSERT INTO `wp_postmeta` VALUES (7743,1251,'_lugar_de_atencion','Oficina de Dirección de Discapacidad, Belgrano 1342 PB Tel: 6091-7100 INT: 6520 <a href=\"mailto:Direccion.Discapacidad@msm.gov.ar\">Direccion.Discapacidad@msm.gov.ar</a>');
INSERT INTO `wp_postmeta` VALUES (7744,1251,'_horarios_de_atencion','De Lunes a Viernes de 8:00hs a 14:00hs, requiere turno previo para Junta Evaluadora Integral de Discapacidad.');
INSERT INTO `wp_postmeta` VALUES (7745,1251,'lugar','Oficina de Dirección de Discapacidad, Belgrano 1342 PB Tel: 6091-7100 INT: 6520 Direccion.Discapacidad@msm.gov.ar');
INSERT INTO `wp_postmeta` VALUES (7746,1251,'observaciones','La renovación del CUD, ya sea por extravío, reagravamiento o primera vez; se realiza en la oficina de atención de lunes a viernes de 08.00hs a 14.00hs. La solicitud de Pase Provincial de Transporte y el C.M.O digitalizado se tramita de manera presencial en la oficina de atención. En caso de que el trámite haya sido denegado en la Junta Evaluadora Integral, por normativa vigente, quien se presente podrá contar con una segunda o hasta tercera instancia de validación, si así lo requiere, en los municipios asignados para tal fin. En cuanto a la exención de impuestos y/o patentes municipales, se realizan por ventanilla de Tasas Municipales, dentro del municipio, tramitando un expediente. El resto de tramitaciones digitales, de tipo peajes, símbolo de automotor, etc., corren por cuenta del usuario a través de la Aplicación Mi Argentina.\n\nDescripción del trámite:\n\n 	Solicitar vía mail los formularios correspondientes a la patología existente, y la planilla de requisitos obligatoria. Enviando mail a Direccion.Discapacidad@msm.gov.ar\n 	Completar y presentar dichos formularios en la oficina de atención.\n\nPresentar la planilla de requisitos obligatoria, con la documentación que ésta solicita.\n\nDocumento que se obtiene:\n\nCertificado Único De Discapacidad.\n\n¿Cómo recibo el resultado del trámite?:\n\nUna vez solicitado el turno para Junta Evaluadora, presentando toda la documentación solicitada, se le informará el mismo día del turno cuándo retirar el Certificado Único de Discapacidad.\n\nTrámites relacionados:\n\nPase para transportes; símbolo nacional de accesibilidad; asignaciones relacionadas; eximición de tasas e impuestos.\n\nCosto del trámite:\n\nGratuito\n\n&nbsp;\n\n&nbsp;');
