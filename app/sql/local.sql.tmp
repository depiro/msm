INSERT INTO `wp_postmeta` VALUES (4842,998,'observaciones','Descripción del trámite:\n\n 	Registrarse en RUAL (Registro Único de Artistas Locales)\n 	Contactarse de manera presencial o virtual con cualquiera de los espacios dispuestos.\n 	Previo al evento completar la primera parte de la Declaración Jurada\n 	Realización del evento\n 	Finalizado el evento, completar la última parte de la Declaración Jurada\n 	Abonar el 25% en Dirección General de Habilitaciones (Av. Balbín 1229 1° Piso) (7 días para pagar la tasa de borderaux).\n\nDocumento que se obtiene:\n\nFotocopias de toda la documentación presentada, sellada por Cultura como constancia de confirmación del evento.\n\n¿Quién lo puede realizar?\n\nArtistas locales registrados en RUAL.\n\nCosto del trámite:\n\nSin costo');
