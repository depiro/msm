INSERT INTO `wp_postmeta` VALUES (6377,1084,'_presentacion_del_tramite','El objetivo del trámite es actualizar la titularidad de la TSM ya que el cambio no es automático. Esto quiere decir que, al momento de adquirir una propiedad, el impuesto de esa propiedad continua a nombre del dueño anterior hasta el momento en el que el nuevo dueño realice dicho trámite.\n\n&nbsp;');
INSERT INTO `wp_postmeta` VALUES (6378,1084,'_requisitos','<ol>\n 	<li>Boleto compra venta con la reposición fiscal + informe de dominio o copia simple de escritura</li>\n 	<li>CUIL O CUIT</li>\n</ol>');
INSERT INTO `wp_postmeta` VALUES (6379,1084,'_duracion_del_tramite','Entre 3 a 10 días hábiles');
INSERT INTO `wp_postmeta` VALUES (6380,1084,'_vigencia_del_documento_obtenido','Hasta que se requiera nueva actualización');
INSERT INTO `wp_postmeta` VALUES (6381,1084,'_respaldo_legal','<a href=\"/boletin-oficial/\">Ordenanza Tarifaria y Fiscal</a>');
INSERT INTO `wp_postmeta` VALUES (6382,1084,'_observaciones','Las Partidas Municipales deben corresponderse con la parcela indicada en la Escritura de referencia, debe poseer “Vigencia administrativa”, es decir, si la parcela sufrió modificaciones por planos (Geodesia o Propiedad Horizontal), éste deberá estar empadronado en el municipio, con Partidas Municipales vigente emitiendo individualmente para realizar dicho trámite.\n<h3><strong>Descripción del trámite:</strong></h3>\n<ol>\n 	<li>Ingresar a <a href=\"https://ventanillaunica.msm.gov.ar/Account/Login\" target=\"_blank\" rel=\"noopener\">Portal de Trámites.</a></li>\n 	<li>Iniciar sesión con clave AFIP/ANSES y seguir los pasos.</li>\n</ol>\n<h3><strong>¿Quién lo puede realizar?:</strong></h3>\nTodos los vecinos propietarios de un inmueble que no hayan actualizado la titularidad de la TSM.\n<h3><strong>Documento que se obtiene:</strong></h3>\nCambio de destinatario TSM.\n<h3><strong>Costo del trámite:</strong></h3>\n<a href=\"https://www.msm.gov.ar/areas-de-hacienda/ingresos-publicos/\">SEGÚN ORDENANZA TARIFARIA Y FISCAL VIGENTE</a>\n\n&nbsp;');
INSERT INTO `wp_postmeta` VALUES (6383,1084,'_lugar_de_atencion','El trámite es online. Se puede iniciar y seguir desde el <a href=\"https://ventanillaunica.msm.gov.ar/Account/Login\">Portal de Trámites</a> de la Municipalidad de San Miguel');
