INSERT INTO `wp_postmeta` VALUES (9160,2756,'_presentacion_del_tramite','La renovación de la habilitación de Transporte Escolar es la continuidad del trámite de habilitación, el cual es un requisito de la Municipalidad de San Miguel para poder ejercer la actividad de transportista en los colegios del partido.');
INSERT INTO `wp_postmeta` VALUES (9161,2756,'_requisitos','<strong>En caso de ser titular del vehículo y también lo conducirlo, o si posee chofer:</strong>\n<ol>\n 	<li>D.N.I. hoja 1,2 y cambio de domicilio (si hay)</li>\n 	<li>Licencia de Conducir con Categoría Habilitante.</li>\n 	<li>Libreta Sanitaria</li>\n 	<li>Certificado de Antecedentes Penales</li>\n</ol>\n<strong>También se necesitará de celador que esté acompañando a los chicos en el viaje:</strong>\n<ol>\n 	<li>D.N.I. hoja 1,2 y cambio de domicilio (si hay).</li>\n 	<li>Libreta Sanitaria</li>\n 	<li>Certificado de Antecedentes Penales</li>\n</ol>\n<strong>Del Vehículo a habilitar:</strong>\n<ol>\n 	<li>Que no sea furgón.</li>\n 	<li>Antigüedad máxima 20 años.</li>\n 	<li>Título del automotor.</li>\n 	<li>Cédula Verde.</li>\n 	<li>Recibo de pago de Patente.</li>\n 	<li>Póliza de Seguro: Escolar o Servicio Especial.</li>\n 	<li>Recibo de pago de Seguro.</li>\n 	<li>VTV</li>\n 	<li>Cédula</li>\n 	<li>Planilla</li>\n 	<li>Libre deuda de infracciones de Tránsito Municipal.</li>\n</ol>\n(Llevar vehículo a la Dirección de Transporte para una inspección técnica) (Documentación original)');
INSERT INTO `wp_postmeta` VALUES (9162,2756,'_duracion_del_tramite','Aproximadamente media hora en la presentación de documentación e inspección técnica, más 72 (setenta y dos) horas una vez confeccionada la Habilitación firmada y controlada por el Director General de Tránsito y Transporte, para retirarla en la Oficina de Transporte.');
INSERT INTO `wp_postmeta` VALUES (9163,2756,'_vigencia_del_documento_obtenido','La habilitación estará vigente durante todo el año escolar.');
INSERT INTO `wp_postmeta` VALUES (9164,2756,'_respaldo_legal','Ordenanza de Transporte 33/14 <a href=\"/boletin-oficial/\">Ordenanza Tarifaria y Fiscal Municipal.</a> Art 55° Ley Nacional de Tránsito y Seguridad Vial (24.449) Disposiciones Provinciales');
