INSERT INTO `wp_postmeta` VALUES (6677,1096,'_presentacion_del_tramite','Zoonosis ofrece servicios gratuitos para la comunidad, dirigidos a dueños de mascotas como perros y gatos.');
INSERT INTO `wp_postmeta` VALUES (6678,1096,'_requisitos','<ul>\n 	<li>La mascota debe estar acompañada por un adulto mayor de 18 años, con DNI y domicilio en San Miguel.</li>\n 	<li><strong>Edad</strong>: Machos a partir de 9 meses y hembras mayores de 6 meses en buen estado de salud.</li>\n 	<li><strong>Transporte</strong>: Usar correa para perros y una transportadora segura para felinos.</li>\n 	<li><strong>Ayuno</strong>: 12 horas de ayuno sólido y 2 horas de ayuno líquido.</li>\n 	<li><strong>Manta de abrigo</strong>: Es recomendable traer una manta para la mascota.</li>\n 	<li><strong>Tiempo post-parto</strong>: Si la hembra ha tenido cría, debe esperar 60 días luego del parto para la castración.</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (6679,1096,'_duracion_del_tramite','Variable según el servicio solicitado.');
INSERT INTO `wp_postmeta` VALUES (6680,1096,'_vigencia_del_documento_obtenido','No aplicable, ya que no se emite un documento. Los servicios se brindan a medida que se solicitan y según disponibilidad.');
