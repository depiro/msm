INSERT INTO `wp_postmeta` VALUES (6552,1091,'_presentacion_del_tramite','<div>\n<div class=\"bg-secretaria border-table\">\n<p class=\"bg-secretaria border-table\">El objetivo del trámite es actualizar la titularidad de la TSM, ya que su actualización no es automática. La TSM de las propiedades se emiten a nombre del último propietario registrado hasta tanto se realice dicho trámite.</p>\n\n</div>\n</div>');
INSERT INTO `wp_postmeta` VALUES (6553,1091,'_requisitos','<ol>\n 	<li>Escritura o informe de dominio</li>\n 	<li>Cuil o Cuit</li>\n</ol>');
INSERT INTO `wp_postmeta` VALUES (6554,1091,'_duracion_del_tramite','Entre 3 a 10 días hábiles');
INSERT INTO `wp_postmeta` VALUES (6555,1091,'_vigencia_del_documento_obtenido','Hasta que se requiera nueva actualización.');
INSERT INTO `wp_postmeta` VALUES (6556,1091,'_respaldo_legal','<ol>\n 	<li>Ordenanza Fiscal</li>\n 	<li>Tarifaria vigente.</li>\n 	<li>Código Civil</li>\n</ol>');
INSERT INTO `wp_postmeta` VALUES (6557,1091,'_observaciones','Las Partidas Municipales deben corresponderse con la parcela indicada en la Escritura de referencia, debe poseer “Vigencia administrativa”, es decir, si la parcela sufrió modificaciones por planos (Geodesia o Propiedad Horizontal), éste deberá estar empadronado en el municipio, con Partidas Municipales vigente emitiendo individualmente para realizar dicho trámite.\n\n<strong>Descripción del trámite:</strong>\n<ol>\n 	<li>Ingresar a <a href=\"https://ventanillaunica.msm.gov.ar/Account/Login\" target=\"_blank\" rel=\"noopener\">Portal de Trámites.</a></li>\n 	<li>Iniciar sesión con clave AFIP/ANSES y seguir los pasos.</li>\n</ol>\n<strong>Documento que se obtiene:</strong>\n\nTSM a nombre del propietario.\n\n<strong>¿Quién lo puede realizar?:</strong>\n\nTodos los vecinos propietarios de un inmueble que no hayan actualizado la titularidad de la TSM.\n\n<strong>Costo del trámite:</strong>\n\n<a href=\"/boletin-oficial/\">SEGÚN ORDENANZA TARIFARIA Y FISCAL VIGENTE</a>\n\n&nbsp;');
INSERT INTO `wp_postmeta` VALUES (6558,1091,'_lugar_de_atencion','El trámite es online. Se puede iniciar y seguir desde el <a href=\"https://ventanillaunica.msm.gov.ar/Account/Login\" target=\"_blank\" rel=\"noopener\">Portal de Trámites</a> de la Municipalidad de San Miguel');
