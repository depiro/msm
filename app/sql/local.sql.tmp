INSERT INTO `wp_postmeta` VALUES (6394,1084,'observaciones','Las Partidas Municipales deben corresponderse con la parcela indicada en la Escritura de referencia, debe poseer “Vigencia administrativa”, es decir, si la parcela sufrió modificaciones por planos (Geodesia o Propiedad Horizontal), éste deberá estar empadronado en el municipio, con Partidas Municipales vigente emitiendo individualmente para realizar dicho trámite.\nDescripción del trámite:\n\n 	Ingresar a Portal de Trámites.\n 	Iniciar sesión con clave AFIP/ANSES y seguir los pasos.\n\n¿Quién lo puede realizar?:\nTodos los vecinos propietarios de un inmueble que no hayan actualizado la titularidad de la TSM.\nDocumento que se obtiene:\nCambio de destinatario TSM.\nCosto del trámite:\nSEGÚN ORDENANZA TARIFARIA Y FISCAL VIGENTE\n\n&nbsp;');
