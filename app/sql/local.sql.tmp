INSERT INTO `wp_postmeta` VALUES (7616,1246,'_respaldo_legal','<a href=\"https://normas.gba.gob.ar/ar-b/ley/2003/13136/3729\">Ley Provincial 13.136</a>');
INSERT INTO `wp_postmeta` VALUES (7617,1246,'_observaciones','<strong>Descripción del trámite:</strong>\n\nAcercarse a la oficina con la documentación requerida.\n\n<strong>¿Quién lo puede realizar?:</strong>\n\nA todos los Monotributistas sociales y Monotributistas Hasta la categoría D (excepto profesionales), que estén adheridos a la LEY ALAs.\n\n<strong>Costo del trámite:</strong>\n\nSin costo.');
