INSERT INTO `wp_postmeta` VALUES (7002,1111,'_presentacion_del_tramite','Para iniciar el trámite debe completar los formularios de solicitud para eximición de la tasa por inspección de seguridad e higiene (TISH) y de ofrecimiento de becas, instalaciones y/o cursos de capacitación.');
INSERT INTO `wp_postmeta` VALUES (7003,1111,'_requisitos','<ol>\n 	<li><strong>Entidades Educativas:</strong></li>\n</ol>\nDebe presentar por única vez al inicio del trámite:\n<ul>\n 	<li>Cartón de habilitación</li>\n 	<li>Constancia de inscripción en Diepregep</li>\n 	<li>Constancia de inscripción en el Ministerio de Educación</li>\n 	<li>Estatuto social (en caso de sociedades)</li>\n 	<li>DNI representante legal</li>\n 	<li>Nota con ofrecimiento de becas</li>\n 	<li>Cursos instalaciones, etc.</li>\n</ul>\n<ol start=\"2\">\n 	<li><strong>Para inmobiliarias:</strong></li>\n</ol>\n<ul>\n 	<li>Cartón de habilitación</li>\n 	<li>Titulo</li>\n 	<li>Constancia de inscripción en colegio de martilleros</li>\n 	<li>Pago de matrícula</li>\n 	<li>DNI</li>\n 	<li>Contrato de locación.</li>\n</ul>\n(Todo en original y copia)\n<ol start=\"3\">\n 	<li><strong>Para entidades sin fines de lucro:</strong></li>\n</ol>\n<ul>\n 	<li>Cartón de habilitación</li>\n 	<li>Reconocimiento municipal</li>\n 	<li>Estatuto de constitución de la entidad donde este plasmado que es sin fines de lucro.</li>\n 	<li>DNI del representante legal</li>\n 	<li>Nota con ofrecimiento de becas</li>\n 	<li>Instalaciones o cursos</li>\n</ul>\n(Todo en original y copia) <a href=\"/wp-content/uploads/2025/02/Formulario-solicitud-de-eximicion-2024.docx\"><strong>FORMULARIO DE SOLICITUD DE EXIMICIÓN</strong></a> El formulario completo y los requisitos según la categoría pueden ser enviados a <a href=\"mailto:EXENCIONES@MSM.GOV.AR\">EXENCIONES@MSM.GOV.AR</a>');
INSERT INTO `wp_postmeta` VALUES (7004,1111,'_duracion_del_tramite','');
INSERT INTO `wp_postmeta` VALUES (7005,1111,'_vigencia_del_documento_obtenido','<ul>\n 	<li>El certificado de eximición entregado es un documento que acredita la eximición de la tasa por el año/s solicitado/s</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (7006,1111,'_respaldo_legal','<a href=\"/boletin-oficial/\" target=\"_blank\" rel=\"noopener\">Ordenanza Fiscal</a>');
INSERT INTO `wp_postmeta` VALUES (7007,1111,'_observaciones','<strong>Descripción del trámite:</strong>\n\nEl titular o responsable del comercio deberá completar los formularios de solicitud de exención y presentar la documentación requerida (según corresponda).\n\n<strong>¿Quiém lo puede realizar?:</strong>\n\nContribuyentes que posean comercios inscriptos en TISH (Colegios, inmobiliarias, entidades sin fines de lucro).\n\n<strong>Costo del trámite:</strong>\n\n<a href=\"/boletin-oficial/\">SEGÚN ORDENANZA TARIFARIA Y FISCAL VIGENTE</a>');
