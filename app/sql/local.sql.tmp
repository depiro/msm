INSERT INTO `wp_postmeta` VALUES (6544,1090,'observaciones','Descripción de trámite:\n\n 	Ingresar a Portal de trámites.\n 	Iniciar sesión con clave AFIP/ANSES y seguir los pasos.\n\nDocumento que se obtiene:\n\nUna partida municipal para cada parcela creada o actualización de superficies en caso de unificaciones.\n\n¿Quién lo puede realizar?\n\nPropietario de la parcela.\n\nCosto del trámite:\n\nSEGÚN ORDENANZA TARIFARIA Y FISCAL VIGENTE');
