INSERT INTO `wp_postmeta` VALUES (8087,1270,'_presentacion_del_tramite','Protege la vivienda familiar de embargos e instancias judiciales contraídas con posterioridad a su afectación');
INSERT INTO `wp_postmeta` VALUES (8088,1270,'_requisitos','<ol>\n 	<li>Escritura de la propiedad</li>\n 	<li>N.I. de los titulares</li>\n 	<li>U.I.L/ C.U.I.T. de los titulares</li>\n 	<li>Acta de matrimonio de los solicitantes (si son casados)</li>\n 	<li>Acta de nacimiento de la/s persona/s a quien va afectado el bien</li>\n 	<li>No interfiere para su afectación la Valuación Fiscal</li>\n</ol>\n<strong>(Original y copia)</strong>');
INSERT INTO `wp_postmeta` VALUES (8089,1270,'_duracion_del_tramite','');
INSERT INTO `wp_postmeta` VALUES (8090,1270,'_vigencia_del_documento_obtenido','El documento público no caduca, vigencia perpetua. Se modifica al pedido del titular');
INSERT INTO `wp_postmeta` VALUES (8091,1270,'_respaldo_legal','Protección a la Vivienda – Ley 14.394');
INSERT INTO `wp_postmeta` VALUES (8092,1270,'_observaciones','<strong>Descripción del trámite:</strong>\n\nPresentarse en Oficina 19 de Subsecretaría de Tierras, Vivienda y Urbanismo.\n\n<strong>Documento que se obtiene:</strong>\n\nProtocolo de Inscripción del Resguardo de la Vivienda y la certificación del mismo en la Escritura Traslativa de Dominio.\n\n<strong>¿Quién lo puede realizar?:</strong>\n\nVecinos de San Miguel que cumplan con los requisitos.\n\n<strong>¿Cómo recibo el resultado del trámite?:</strong>\n\nMediante llamado, correo electrónico, y notificación al domicilio del vecino, citándolo para retirar el mismo.\n\n<strong>Costo del trámite:</strong>\n\nSin costo.\n\n&nbsp;');
INSERT INTO `wp_postmeta` VALUES (8093,1270,'_lugar_de_atencion','Subsecretaria de Tierras, Vivienda y Urbanismo Social, Oficina 19 dentro del edificio municipal (Sarmiento 1551, San Miguel)');
INSERT INTO `wp_postmeta` VALUES (8094,1270,'_horarios_de_atencion','<ul>\n 	<li>Lunes a Viernes de 8 a 14 hs.</li>\n 	<li>Teléfono: 6091-7185 int. 6812</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (8095,1270,'lugar','Subsecretaria de Tierras, Vivienda y Urbanismo Social, Oficina 19 dentro del edificio municipal (Sarmiento 1551, San Miguel)');
INSERT INTO `wp_postmeta` VALUES (8096,1270,'observaciones','Descripción del trámite:\n\nPresentarse en Oficina 19 de Subsecretaría de Tierras, Vivienda y Urbanismo.\n\nDocumento que se obtiene:\n\nProtocolo de Inscripción del Resguardo de la Vivienda y la certificación del mismo en la Escritura Traslativa de Dominio.\n\n¿Quién lo puede realizar?:\n\nVecinos de San Miguel que cumplan con los requisitos.\n\n¿Cómo recibo el resultado del trámite?:\n\nMediante llamado, correo electrónico, y notificación al domicilio del vecino, citándolo para retirar el mismo.\n\nCosto del trámite:\n\nSin costo.\n\n&nbsp;');
