INSERT INTO `wp_postmeta` VALUES (6069,1069,'observaciones','En caso de no lograr hacerlo, o ante cualquier duda o consulta, puede comunicarse al: 0800-222-8324 o vía e-mail a atencionalvecino@msm.gov.ar.\n\nCosto del trámite:\n\nEl valor de la Infracción de Estacionamiento Medido en las primeras 72hs del Pago Voluntario posee un 50% de descuento que equivale a 50 horas de Estacionamiento. Luego de ese tiempo el Acta se encontrará en el Juzgado Municipal de Faltas y tendrá su valor completo equivalente a 100 horas de Estacionamiento.');
