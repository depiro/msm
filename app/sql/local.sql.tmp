INSERT INTO `wp_postmeta` VALUES (5652,1048,'_presentacion_del_tramite','A través de este trámite el titular puede obtener 1 copia certificada del Plano de Obra Aprobado o Registrado de su propiedad.');
INSERT INTO `wp_postmeta` VALUES (5653,1048,'_requisitos','<ol>\n 	<li>Para realizar el trámite se requiere poseer previamente un plano aprobado y archivado en el municipio.</li>\n 	<li>Completar toda la información obligatoria que se solicita.</li>\n 	<li>Tener aval para efectuar el pedido:\n<ul>\n 	<li>En el caso del titular del domino: Debe acreditar dominio sobre el inmueble con la escritura o boleto.</li>\n 	<li>Tercera persona autorizada: Debe subir la solicitud de copia firmada por el titular del dominio y los documentos que acreditan la titularidad de quien firma la nota.</li>\n</ul>\n</li>\n 	<li>Pagar la tasa del trámite correspondientes por las copias.</li>\n</ol>');
INSERT INTO `wp_postmeta` VALUES (5654,1048,'_duracion_del_tramite','De 2 a 5 días hábiles desde el momento que el expediente llega a la Dirección de Obras Particulares.');
INSERT INTO `wp_postmeta` VALUES (5655,1048,'_vigencia_del_documento_obtenido','Permanente');
INSERT INTO `wp_postmeta` VALUES (5656,1048,'_respaldo_legal','<ul>\n 	<li>Reglamento de construcciones, <a href=\"https://www.msm.gov.ar/wp-content/uploads/2018/10/CODIGO-DE-EDIFICACION.pdf\">Ordenanza nº 595/82</a></li>\n 	<li><a href=\"/boletin-oficial/\">Ordenanza Tarifaria y Fiscal Vigente</a></li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (5657,1048,'_observaciones','El trámite debe iniciarlo el titular de la parcela o quien este autorizado por el titular del Dominio y deberá realizar los siguientes pasos:\n<ol>\n 	<li>Ingresar al link del <a href=\"https://ventanillaunica.msm.gov.ar/\"><u>Portal de Trámites</u></a></li>\n 	<li>Loguearse con clave AFIP o con clave ANSES</li>\n 	<li>Seleccionar “Copia de Plano”, (debe iniciar un trámite por cada Partida).</li>\n 	<li>Ir a “Iniciar Trámite”, completar campos obligatorios en “Caratula”, y en “Documentación Respaldatoria”</li>\n 	<li>Debe hacer click en el botón “Guardar” y luego en “Confirmar”</li>\n 	<li>De esta forma el trámite se envía al Municipio, y recibirá un sellado que deberá abonar y subir al Portal.</li>\n</ol>\n<strong>Documento que se obtiene:</strong>\n\nCopia Certificada de Plano con código QR que certifica su autenticidad. En ningún caso se entregaran copias de planos NO APROBADOS. Si el expediente solicitado no se encuentra en los archivos, se otorga Parcelario de Copia de Plano con los datos proporcionados por la Dirección de Catastro.\n\n<strong>¿Quién lo puede realizar?:</strong>\n\nEl trámite de Solicitud de Copia de Plano puede ser desarrollado por el titular del dominio sobre el inmueble (un trámite por cada partida); o por quién esté autorizado por el titular del dominio en una nota de solicitud de copia de plano. Solo se entregarán copias de aquellos planos que hayan sido aprobados por el Municipio. El usuario podrá solicitar más de un tipo de alcance de plano o expediente para la misma parcela (por ejemplo: copia de plano aprobado y copia de plano de demolición).\n\n<strong>¿Cómo recibo el resultado del trámite?:</strong>\n\nDesde el <a href=\"https://ventanillaunica.msm.gov.ar/\">Portal de Trámites</a>, ingresando con su clave AFIP O ANSES obtendrá la copia certificada con código QR o  parcelario de Copia de Plano si no se encontrara el plano en los archivos.\n\n&nbsp;');
INSERT INTO `wp_postmeta` VALUES (5658,1048,'_lugar_de_atencion','<a href=\"https://ventanillaunica.msm.gov.ar/\">Portal de Trámites</a>');
INSERT INTO `wp_postmeta` VALUES (5659,1048,'_horarios_de_atencion','24hs.');
