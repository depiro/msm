INSERT INTO `wp_postmeta` VALUES (7763,1254,'_requisitos','<ol>\n 	<li>Poseer Certificado Único de Discapacidad vigente.</li>\n 	<li>Poseer D.N.I. vigente.</li>\n</ol>');
