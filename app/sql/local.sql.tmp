INSERT INTO `wp_postmeta` VALUES (8926,2746,'observaciones','Documento que se obtiene:\n\nComprobante de autorización de utilización del Predio.\n\nDescripción del trámite:\n\n 	Descargar el formulario adjunto, o solicitar una copia en la oficina de la Subsecretaría de Deportes.\n 	Completarlo y presentarlo en la Subsecretaría de Deportes.\n 	Verificar la aprobación de la fecha solicitada.\n 	En caso de tratarse de una salida educativa debe acercar a la dirección de turismo, tercera edad y recreación la autorización de la autoridad escolar correspondiente.\n\n¿Quién lo puede realizar?:\n\nInstituciones Educativas, Clubes, Sociedades de Fomento y otras Instituciones de bien público de San Miguel.\n\nCosto del trámite:\n\nGratuito\n\n&nbsp;');
