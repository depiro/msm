INSERT INTO `wp_postmeta` VALUES (7811,1260,'_edit_last','1');
INSERT INTO `wp_postmeta` VALUES (7812,1260,'_presentacion_del_tramite','La ampliación de la licencia de conducir es el trámite que permite a una persona agregar nuevas categorías a su registro, a partir de las cuales podrá conducir diferentes vehículos, dependiendo la categoría autorizada. Pueden solicitar su ampliación las personas mayores de 17 años que tengan DNI con domicilio en San Miguel y una licencia con antigüedad mínima de un año.');
INSERT INTO `wp_postmeta` VALUES (7813,1260,'_requisitos','<ul>\n 	<li>DNI o comprobante de DNI en trámite con domicilio en el partido de San Miguel. Asistir al turno con fotocopia del mismo.</li>\n 	<li>Licencia de conducir con antigüedad mínima de un año en clase B o denuncia de robo/ extravío (Presentar fotocopia de la denuncia).</li>\n 	<li>Certificado de legalidad impreso si tu última licencia no fue emitida por algún Municipio de la Provincia de Buenos Aires.</li>\n 	<li>Certificado de antecedentes penales impreso para clases profesionales (C, D, E) tiene 1 mes de validez. <a href=\"https://www.msm.gov.ar/wp-content/uploads/2015/01/Informacion-Certificado-de-Antecendes-Penales.pdf\" target=\"_blank\" rel=\"noopener\"><i>Consultá</i>  <i>aquí</i></a></li>\n 	<li>Para clases profesionales ser mayor de 21 años.</li>\n 	<li>Rendir exámenes teóricos y prácticos según corresponda.</li>\n 	<li>No poseer infracciones de tránsito impagas.</li>\n 	<li>Para el examen práctico te debe acompañar una persona que tenga licencia de conducir con clase que lo habilite para dicho vehículo. Este debe contar con la documentación en regla.</li>\n 	<li>Certificado de Legalidad impreso si tu licencia fue emitida en CABA o en alguna otra provincia (Que no sea Buenos Aires).</li>\n</ul>\nRequisitos por categoría:\n<ul>\n 	<li><b>Clase A1 (moto)</b>\n<ul>\n 	<li> Menores de 21 años: Pueden ampliar su categoría hasta 300cc con antigüedad mínima de 2 años en cilindradas menores.</li>\n 	<li>Mayores de 21 años: Sin restricción de cilindrada, debe contar con antigüedad mínima de 1 año en cilindradas menores.</li>\n</ul>\n</li>\n 	<li><b>Clase A2 (cuatriciclo</b>)\n<ul>\n 	<li> 1°vez hasta 300cc</li>\n 	<li>1 año de antigüedad de manejo para ampliar a cilindradas superiores</li>\n</ul>\n</li>\n 	<li><b>Clase </b><b>B1(auto/camioneta 3500 kg)</b>\n<ul>\n 	<li>Licencia que se se entrega normalmente por primera vez a mayores de 18</li>\n</ul>\n</li>\n 	<li><b>Clase B2</b> <b>(auto/camioneta con trailer hasta 750kg)</b>\n<ul>\n 	<li> 1 año antigüedad de manejo en clase B1</li>\n</ul>\n</li>\n 	<li><b>Clase F</b> <b>(vehículo que requiera alguna adaptación)</b>\n<ul>\n 	<li>Concurrir con el vehículo adaptado para verificar. Las observaciones estarán impresas en la licencia. Podés ampliar clases particulares (moto hasta 300cc, auto/camioneta)</li>\n</ul>\n</li>\n 	<li><b>Clases profesionales</b>:\n<ul>\n 	<li>Mayores de 21 años con 1 año de antigüedad de manejo en clase B.</li>\n 	<li>Saber leer y escribir.</li>\n 	<li>Certificado de antecedentes penales impreso para clases profesionales (C, D, E) tiene 1 mes de validez.</li>\n</ul>\n</li>\n</ul>\nPodes consultar material de estudio <a href=\"/licencias-2/capacitate/\" target=\"_blank\" rel=\"noopener\"><i>aquí</i></a>');
INSERT INTO `wp_postmeta` VALUES (7814,1260,'_duracion_del_tramite','2 HORAS\n<ul>\n 	<li>En caso de lluvia (no se puede rendir el exámen práctico) puede volver al otro día sin turno</li>\n 	<li>En caso de tener que rendir nuevamente algún examen, se puede volver otro día sin turno.</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (7815,1260,'_vigencia_del_documento_obtenido','<ul>\n 	<li>Conserva la vigencia de la Licencia anterior.</li>\n 	<li>Para clases profesionales el tiempo de vigencia es:</li>\n</ul>\n- 21 a 45 por 2 años.\n\n- 46 en adelante por 1 año\n<ul>\n 	<li>Los mayores de 65 años no podrán obtener clases profesionales por primera vez.</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (7816,1260,'_respaldo_legal','');
INSERT INTO `wp_postmeta` VALUES (7817,1260,'_observaciones','<strong>Descripción del trámite:</strong>\n<ul>\n 	<li><a href=\"/licencias-2/turnos/\">Sacar turno desde la Web </a> o desde el 147.</li>\n 	<li>Presentarse en la Dirección de Licencias de Conducir en el horario indicado con el código de turno.</li>\n 	<li>Debe rendir examen teórico y práctico de las clases a ampliar.</li>\n 	<li>Realizar el examen psicofísico.</li>\n 	<li>Abonar tasas nacionales, provinciales y municipales.</li>\n 	<li> Toma de datos, fotografía digital, huella y firma.</li>\n</ul>\n<strong>Documento que se obtiene:</strong>\n\nLicencia de conducir con categorías ampliadas.\n\n<strong>Costo del trámite:</strong>\n<ul>\n 	<li>Público General: $28.750</li>\n 	<li>Jubilados Mayores de 70: $8950 (Presentar copia del recibo de haberes)</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (7818,1260,'_lugar_de_atencion','Pte.Perón 415 Muñiz. Dirección licencias de conducir. <a href=\"https://www.msm.gov.ar/gestion-publica/areas-gestion-publica/licencias-de-conducir/turnos-de-licencias-de-conducir/\">Sacar turno desde la Web</a>');
INSERT INTO `wp_postmeta` VALUES (7819,1260,'_horarios_de_atencion','De lunes a viernes de 8hs a 14hs. Asistir al horario del turno solicitado.');
INSERT INTO `wp_postmeta` VALUES (7820,1260,'lugar','Pte.Perón 415 Muñiz. Dirección licencias de conducir. Sacar turno desde la Web');
INSERT INTO `wp_postmeta` VALUES (7821,1260,'observaciones','Descripción del trámite:\n\n 	Sacar turno desde la Web  o desde el 147.\n 	Presentarse en la Dirección de Licencias de Conducir en el horario indicado con el código de turno.\n 	Debe rendir examen teórico y práctico de las clases a ampliar.\n 	Realizar el examen psicofísico.\n 	Abonar tasas nacionales, provinciales y municipales.\n 	 Toma de datos, fotografía digital, huella y firma.\n\nDocumento que se obtiene:\n\nLicencia de conducir con categorías ampliadas.\n\nCosto del trámite:\n\n 	Público General: $28.750\n 	Jubilados Mayores de 70: $8950 (Presentar copia del recibo de haberes)');
