INSERT INTO `wp_postmeta` VALUES (7511,1183,'_edit_last','1');
INSERT INTO `wp_postmeta` VALUES (7512,1183,'_presentacion_del_tramite','El carnet de manipulador de alimentos es un requisito obligatorio para toda persona que esté en contacto con alimentos por la actividad que realiza, en establecimientos donde se elaboren, fraccionen, almacenen, transporten, comercialicen y/o enajenen alimentos, o sus materias primas.\n\nLa Municipalidad de San Miguel derogó la libreta sanitaria para aquellos establecimientos comerciales e industriales que realizan manipulación de alimentos.\n\nDicha libreta fue reemplazada por un Carnet de Manipulación de Alimentos cuya duración es de 3 años, que se obtiene luego de realizar una capacitación.\n\n<strong>INSCRIPCIÓN AL CURSO</strong>\n\nDeberá solicitar al teléfono de Ayuda en Línea 11-3884-9649 la información del Curso de Manipulación de Alimentos. Allí se le enviará el folleto donde se detalle lugar y horario. También se le enviará el link de inscripción al curso (un formulario de google) que deberá completar.');
INSERT INTO `wp_postmeta` VALUES (7513,1183,'_requisitos','Toda persona física que esté en contacto con alimentos por la actividad que realiza\n<ul>\n 	<li>Foto del DNI.</li>\n 	<li>Foto tipo Carnet.</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (7514,1183,'_duracion_del_tramite','La inscripción es digital, el curso tendrá dos jornadas presenciales.');
INSERT INTO `wp_postmeta` VALUES (7515,1183,'_vigencia_del_documento_obtenido','El carnet de manipulación de alimentos tiene una duración de 3 (tres) años.');
