INSERT INTO `wp_postmeta` VALUES (7671,1248,'observaciones','Descripción del trámite:\n\nComunicarse con la oficina por cualquiera de sus medios, para concretar una entrevista.\n\nDocumento que se obtiene:\n\n 	Denegación del microcrédito, por diferentes factores.\n 	Aprobación del microcrédito, con el cual se obtendrá un financiamiento con fondos municipales, a tasa subsidiada.\n\n¿Quién lo puede realizar?:\n\nEmprendedores mayores de 18 años que residan en el partido de san miguel, y realicen actividades de producción y/o comercialización de bienes y/o servicios.\n\nCosto del trámite:\n\nSin costo.');
