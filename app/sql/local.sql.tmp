INSERT INTO `wp_postmeta` VALUES (6169,1075,'observaciones','El Certificado de Aptitud Ambiental es condición obligatoria para el funcionamiento y habilitación de los establecimientos industriales en toda la provincia de Buenos Aires.\n\nDescripción del trámite:\n\nPresentar la documentación solicitada en la Subsecretaría de Ambiente.\n\nDocumento que se obtiene:\n\nCertificado de Aptitud Ambiental.\n\n¿Quién lo puede realizar?:\n\nIndustrias que deban renovar el CAA luego de haber trascurrido los 4 años de vigencia. (Conforme Decreto 531/19).\n\nCosto del trámite:\n\nSEGÚN ORDENANZA TARIFARIA VIGENTE');
