INSERT INTO `wp_postmeta` VALUES (7587,1245,'_presentacion_del_tramite','Este trámite permite que los comercios obtengan la Licencia REBA para la comercialización de bebidas alcohólicas.');
INSERT INTO `wp_postmeta` VALUES (7588,1245,'_requisitos','● Habilitación Municipal.\n\n● Documento del titular (si el comercio es unipersonal).\n\n● Si es una sociedad: Documento del presidente, Estatuto y Libro de Actas de directorio.\n\n● Si lo realiza un apoderado: Documento del apoderado y Poder Legal.\n\n● Declaración Jurada Anual de Ingresos Brutos y último pago.\n\n● Renovación: Adjuntar la última licencia REBA emitida.');
INSERT INTO `wp_postmeta` VALUES (7589,1245,'_duracion_del_tramite','48 horas hábiles');
INSERT INTO `wp_postmeta` VALUES (7590,1245,'_vigencia_del_documento_obtenido','12 meses.');
INSERT INTO `wp_postmeta` VALUES (7591,1245,'_respaldo_legal','Ley 15109/19 con su decreto reglamentario Dec. 11/19  y la ley 11825/96');
INSERT INTO `wp_postmeta` VALUES (7592,1245,'_observaciones','<h3><strong>Descripción del trámite:</strong></h3>\nEste trámite permite que los comercios obtengan la Licencia REBA para la comercialización de bebidas alcohólicas. El trámite puede ser realizado de manera presencial o virtual. A continuación, los pasos generales:\n<ol>\n 	<li>El contribuyente debe presentar la documentación requerida en la oficina de Habilitaciones o enviarla por WhatsApp para tramitar la inscripción o renovación del certificado.</li>\n 	<li>Después de recibir el formulario, el contribuyente debe abonar el costo correspondiente en puntos verificados de Provincia NET.</li>\n 	<li>Una vez realizado el pago, debe enviar el comprobante de pago por WhatsApp o acercarlo a la oficina de Habilitaciones.</li>\n 	<li>Al día siguiente de enviar el comprobante de pago, el titular podrá retirar el certificado de REBA.</li>\n</ol>\n<h3><strong>Cantidad de veces que se debe asistir al origanismo:</strong></h3>\n1 o 2 veces: según si se realiza presencial o de manera virtual.\n<h3><strong>¿Cómo recibo el resultado del trámite?</strong></h3>\nSe notificará al contribuyente para que pase a retirar su Licencia REBA.\n\n<strong>Costo del trámite:\n</strong>Gratuito.\n\n<strong>Contacto:\n</strong>Puedes contactarte a través de WhatsApp de Ayuda en Línea: 11 2897-1924');
INSERT INTO `wp_postmeta` VALUES (7593,1245,'_lugar_de_atencion','Oficina en Sarmiento 1686');
INSERT INTO `wp_postmeta` VALUES (7594,1245,'_horarios_de_atencion','De 8:00 a 14:00 hs');
INSERT INTO `wp_postmeta` VALUES (7595,1245,'lugar','Oficina en Sarmiento 1686');
INSERT INTO `wp_postmeta` VALUES (7596,1245,'observaciones','Descripción del trámite:\nEste trámite permite que los comercios obtengan la Licencia REBA para la comercialización de bebidas alcohólicas. El trámite puede ser realizado de manera presencial o virtual. A continuación, los pasos generales:\n\n 	El contribuyente debe presentar la documentación requerida en la oficina de Habilitaciones o enviarla por WhatsApp para tramitar la inscripción o renovación del certificado.\n 	Después de recibir el formulario, el contribuyente debe abonar el costo correspondiente en puntos verificados de Provincia NET.\n 	Una vez realizado el pago, debe enviar el comprobante de pago por WhatsApp o acercarlo a la oficina de Habilitaciones.\n 	Al día siguiente de enviar el comprobante de pago, el titular podrá retirar el certificado de REBA.\n\nCantidad de veces que se debe asistir al origanismo:\n1 o 2 veces: según si se realiza presencial o de manera virtual.\n¿Cómo recibo el resultado del trámite?\nSe notificará al contribuyente para que pase a retirar su Licencia REBA.\n\nCosto del trámite:\nGratuito.\n\nContacto:\nPuedes contactarte a través de WhatsApp de Ayuda en Línea: 11 2897-1924');
