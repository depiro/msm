INSERT INTO `wp_postmeta` VALUES (7083,1115,'_respaldo_legal','');
INSERT INTO `wp_postmeta` VALUES (7084,1115,'_observaciones','<strong>Descripción del trámite:</strong>\n<ol>\n 	<li>Presentar <a href=\"/wp-content/uploads/2025/02/DDJJ-Anual.pdf\">formulario</a> con todos los datos completos para verificar si los montos abonados son correctos.</li>\n 	<li>Luego de presentado el formulario, se verifican los datos y si está todo correcto, se le entrega copia sellada.</li>\n 	<li>En caso de existir diferencia, el agente procederá a la liquidación correspondiente.</li>\n</ol>\n<strong>Documento que se obtiene:</strong>\n\nCopia sellada y firmada por el Agente que la recepciona, y la misma puede ser utilizada para realizar los diversos trámites relacionados al comercio.\n\n<strong>¿Quén lo puede realizar?:</strong>\n\nContribuyentes que posean comercios inscriptos en TSH y PyP\n\n<strong>Costo del trámite:</strong>\n\nSin costo.');
