INSERT INTO `wp_postmeta` VALUES (7712,1250,'_presentacion_del_tramite','En caso de estar inscripto en IIBB y ser categoría A, B, C o D del monotributo, puede adherirse a la Ley Alas (Ley Provincial 13.136, de ACTIVIDADES LABORALES AUTEGESTIVAS Y DE SUBSISTENCIA ECONOMICAS DEL AUTOEMPLEO) para obtener la exención de pago del monotributo.');
INSERT INTO `wp_postmeta` VALUES (7713,1250,'_requisitos','<ol>\n 	<li>Copia de DNI</li>\n 	<li>Copia de la constancia de opción (Monotributo)</li>\n 	<li>Un servicio a su nombre:</li>\n</ol>\n(Luz, Gas, Teléfono, Impuesto, con el ultimo ticket pago)\n<ol start=\"4\">\n 	<li>Cuil</li>\n 	<li>Credencial del Monotributo</li>\n 	<li>Ultimo ticket pago de Monotributo</li>\n 	<li>Constancia de la actividad en la cual se inscribieron y código de la actividad</li>\n</ol>');
