INSERT INTO `wp_postmeta` VALUES (6777,1100,'_presentacion_del_tramite','El trámite se realiza para todo titular de un vehículo de transporte de alimentos.\n\nPasos a seguir:\n<ol>\n 	<li>El titular de la unidad vehicular deberá acercarse a la Dirección General de Inspecciones y Departamento de Bromatología en Sarmiento 1686 con la documentación requerida y el vehículo, para ser inspeccionado.</li>\n 	<li>Abonar el canon anual correspondiente.</li>\n 	<li>Acercarse a la Dirección de Bromatología y retirar el certificado.</li>\n</ol>');
INSERT INTO `wp_postmeta` VALUES (6778,1100,'_requisitos','Toda persona física que sea titular de un vehículo de transporte de alimentos.\n<ul>\n 	<li>DNI del titular de la unidad.</li>\n 	<li>DNI del/ los choferes + Registro de conducir con categoría habilitante + Cédula azul.</li>\n 	<li>Título y cédula verde del automotor.</li>\n 	<li>Último recibo de pago de patente.</li>\n 	<li>Comprobante de pago de seguro vigente.</li>\n 	<li>Verificación técnica vehicular (VTV) vigente.</li>\n 	<li>Libretas sanitarias del conductor y acompañante.</li>\n 	<li>Certificado de fumigación vigente.</li>\n 	<li>Libre deuda de infracciones.</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (6779,1100,'_duracion_del_tramite','');
INSERT INTO `wp_postmeta` VALUES (6780,1100,'_vigencia_del_documento_obtenido','El permiso de Transporte se renueva una vez por año.');
