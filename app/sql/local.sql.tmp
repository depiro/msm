INSERT INTO `wp_postmeta` VALUES (6644,1094,'observaciones','En caso de obras de Telecomunicaciones se le transfiere a la Subsecretaría de Modernización.\n\nDescripción del trámite:\n\n 	Presentarse en la Dirección General de Infraestructura donde se obtendrá un Sellado para dar inicio al trámite.\n 	Con toda la documentación requerida y el comprobante de pago del Sellado, se deberá iniciar el expediente en la Mesa de Entradas de la Municipalidad.\n 	El expediente será evaluado por la Dirección General de Infraestructura, quien se comunicará con la persona de contacto declarada por cualquier duda o requerimiento adicional y avisará cuando esté finalizado el Permiso para ser retirado.\n 	Para retirar el Permiso debe presentarse en la Dirección Gral. de Infraestructura donde se obtendrá la boleta para realizar el pago de los Derechos Municipales, en caso de corresponder de acuerdo a la obra.\n 	Realizado el pago se le entregará el Permiso que habilita el inicio de las tareas.\n\nDocumento que se obtiene:\n\nPermiso de trabajo en la Vía Publica.\n\n¿Quién lo puede realizar?:\n\nEmpresas de servicios públicos y empresas de infraestructura asociadas a servicios públicos.\n\n¿Cómo recibo el resultado del trámite?:\n\nSe retira presencialmente.\n\nCosto del trámite:\n\nInicio un expediente $300.30 Obras contratadas por el Estado Municipal 0% Obras contratadas por empresas de servicios públicos aéreo 3% Obras contratadas por empresas de servicios públicos soterrado 0% Obras contratadas por organismos públicos, provinciales o nacionales 0%.\n\n&nbsp;\n\n&nbsp;');
