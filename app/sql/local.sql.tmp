INSERT INTO `wp_postmeta` VALUES (7059,1113,'_observaciones','<strong>COSTO DE TRAMITE:</strong> sin costo\n\n<strong>DURACION DEL TRAMITE:</strong> aproximadamente 15 min\n\n<strong>DESCRPCIÓN DEL TRÁMITE:</strong>\n<ol>\n 	<li>Dirigirse a la Dirección de Tasas de Servicios Municipales con la documentación requerida.</li>\n 	<li>Presentar los recibos originales de los pagos en cuestión.</li>\n 	<li>Firmar solicitud de inicio de expediente explicitando reintegro o acreditación del monto emergente de la diferencia.</li>\n</ol>');
