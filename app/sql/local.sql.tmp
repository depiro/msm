INSERT INTO `wp_postmeta` VALUES (8006,1267,'_requisitos','<ol>\n 	<li>Cumplir 10 años de inscripción del Acta- Escritura (Ley 24.374)</li>\n 	<li>Original Acta/ Escritura (ley 24.374)</li>\n 	<li>N.I. del titular</li>\n 	<li>U.I.L/ C.U.I.T. del titular</li>\n</ol>');
