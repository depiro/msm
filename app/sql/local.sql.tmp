INSERT INTO `wp_postmeta` VALUES (6077,1070,'_presentacion_del_tramite','<ul>\n 	<li>Descargar la APP SEM San Miguel para Android o SEM Mobile para iOS, o también puede hacerse desde la <a href=\"/sem-2/\">Estacionamiento Medido</a></li>\n 	<li>Ingresar a la opción “¿Olvidó su contraseña?”.</li>\n</ul>\nEl sistema va a solicitar que se indique el nombre de usuario o la dirección de correo electrónico que está asociada a la cuenta.\n<ul>\n 	<li>Una vez completo ese dato, hacer click en el botón “Recuperar Contraseña”.</li>\n 	<li>Se enviará un mail con un link al que se debe ingresar para modificar la contraseña.</li>\n 	<li>En el mismo mail se indicará nombre de usuario. Debajo del link encontrará la leyenda “Su nombre de usuario es:”.</li>\n</ul>\nEn caso de no haber recibido este mail, verificar la casilla de correo no deseado o SPAM.\n<ul>\n 	<li>Si no pudiste recuperar tu usuario y contraseña o no sabes cómo nosotros podemos ayudarte. Comunícate al 0800-222-8324 o vía e-mail a <a href=\"mailto:atencionalvecino@msm.gov.ar\">atencionalvecino@msm.gov.ar</a> o podes acercarte a la Oficina de Estacionamiento Medido en Cámara de comercio Planta Baja (Domingo F. Sarmiento 1663)</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (6078,1070,'_requisitos','Contar con la APP SEM San Miguel para Android o SEM Mobile para iOS, o acceso a la <a href=\"/sem-2/\">Estacionamiento Medido</a>');
