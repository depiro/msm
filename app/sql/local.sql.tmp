INSERT INTO `wp_postmeta` VALUES (6144,1073,'observaciones','ORGANISMOS RESPONSABLE: Ministerio de Ambiente de la Provincia de Buenos Aires, Subsecretaría de Ambiente - Dirección de Evaluación y Control Ambiental.\n\nEl Organismo responsable de dar respuesta al trámite es el Ministerio de Ambiente de la Provincia de Bs. AS., no depende de la Dirección de Evaluación y Control Ambiental de la Municipalidad de San Miguel.\n\nTodas las notificaciones del trámite serán informadas en la casilla de mensajes del portal de Trámites del Ministerio de Ambiente de la PBA.\n\nEste trámite resulta vital para habilitar la instancia de obtención del CAA. Sin dicho Certificado, el funcionamiento del establecimiento se encontrará en infracción a la Ley Provincial N° 11.459.\n\nDURACIÓN DEL TRÁMITE: 1 mes\n\nCOSTO: No hay costo Municipal, solo lo que determine el Ministerio de Ambiente del PBA.\n\nQUIEN LO PUEDE REALIZAR: Establecimientos industriales que proyecten realizar acciones que modifiquen su Nivel de Complejidad Ambiental (aumento de superficie, de potencia instalada, rubro, etc.).\n\nDESCRIPCIÓN DEL TRAMITE:\n\n 	Ingresar a http://www.sitdt.gba.gob.ar/Account/Login?ReturnUrl=,\n 	Dirigirse a la solapa de “DESARROLLO DE TRAMITES”\n 	Dirigirse a la solapa de “CERTIFICADO DE APTITUD AMBIENTAL”\n 	Dirigirse a la solapa de “CLASIFICACIÓN DEL NIVEL DE COMPLEJIDAD AMBIENTAL”\n 	Dirigirse a “RECLASIFICACIÓN”\n\nDOCUMENTO QUE SE OBTIENE: Disposición de Reclasificación - Certificado de Aptitud Ambiental (CAA)\n\n&nbsp;');
INSERT INTO `wp_postmeta` VALUES (6145,1075,'ubicacion','');
