INSERT INTO `wp_postmeta` VALUES (5452,1039,'_presentacion_del_tramite','El Registro de Transportista Habilitado de Aceite Vegetal Usado (AVU) está dirigido a empresas de transporte de residuos no especiales, que se dediquen a la recolección de Aceite Vegetal Usado en todo el territorio del partido de San Miguel. Dicha actividad se encuentra enmarcada en la <a href=\"/boletin-oficial/\">Ordenanza Municipal N°39/2012</a> que da origen al Programa Convertir Aceite, para el aprovechamiento del AVU para la producción de biocombustible. Ninguna empresa podrá recolectar AVU en el partido de San Miguel si no se encuentra inscripta en este Registro.');
INSERT INTO `wp_postmeta` VALUES (5453,1039,'_requisitos','<ul>\n 	<li>Formulario de Registro Obligatorio de Transportista de AVU Habilitado.</li>\n 	<li>Original y Copia de la Resolución vigente del Ministerio de Ambiente de la provincia de Buenos Aires, que habilita a la empresa como Transportista de Residuos No Especiales.</li>\n 	<li>Original y copia de la siguiente documentación correspondiente a los vehículos habilitados por el Ministerio de Ambiente de la provincia de Buenos Aires:\n- Cedula Verde y Azul de los vehículos.\n- Póliza de Seguros y último pago.\n- Certificado de VTV vigente.\n- Licencia de Conducir de los choferes.\n- DNI de choferes y operarios.</li>\n</ul>\n-Título de propiedad de vehículos\n<ul>\n 	<li>Último Certificado de Disposición Final de AVU con destino a la producción de biocombustible.</li>\n 	<li>Certificado de Aptitud Ambiental vigente.</li>\n 	<li>Copia de último Convenio de Colaboración vigente, firmado con el Municipio de San Miguel.</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (5454,1039,'_duracion_del_tramite','Presentada toda la documentación necesaria, tu trámite estará finalizado en un plazo máximo de 10 días hábiles.');
INSERT INTO `wp_postmeta` VALUES (5455,1039,'_vigencia_del_documento_obtenido','El Registro tiene una vigencia de año, una vez vencido se deberá renovar el Convenio y el Registro.');
INSERT INTO `wp_postmeta` VALUES (5456,1039,'_respaldo_legal','<a href=\"https://www-dev.msm.gov.ar/boletin-oficial/\">Ordenanza Municipal 39/2012.</a>');
INSERT INTO `wp_postmeta` VALUES (5457,1039,'_observaciones','<strong>Descripción del trámite:</strong>\n<ol>\n 	<li>Una vez que posea la documentación necesaria, descargue <a href=\"/wp-content/uploads/2025/02/Formulario-Registro-de-Transportistas.doc\" target=\"_blank\" rel=\"noopener\">Formulario Registro de transportistas</a>.</li>\n 	<li>Complete el formulario y solicite un turno de atención enviando un correo electrónico a la siguiente dirección: <a href=\"mailto:ambiente@msm.gov.ar\" target=\"_blank\" rel=\"noopener\" data-rawhref=\"mailto:ambiente@msm.gov.ar\">ambiente@msm.gov.ar</a></li>\n</ol>\n<ol start=\"3\">\n 	<li>Preséntese en la oficina de la Subsecretaría de Ambiente en el día y horario indicado junto al formulario firmado y los originales y fotocopias de toda la documentación solicitada</li>\n</ol>\n<strong>Documento que se obtiene:</strong> Constancia de Registro de Transportista de AVU Habilitado.\n\n<strong>Costo del trámite:</strong> No tiene costo');
INSERT INTO `wp_postmeta` VALUES (5458,1039,'_lugar_de_atencion','Subsecretaría de Ambiente, sito en Domingo Faustino Sarmiento 1551, San Miguel');
INSERT INTO `wp_postmeta` VALUES (5459,1039,'_horarios_de_atencion','Lunes a viernes de 9hs a 16hs.  Se requiere turno previo que debe ser solicitado enviando un correo electrónico a <a href=\"mailto:dir.medioambiente@msm.gov.ar\">dir.medioambiente@msm.gov.ar</a>');
