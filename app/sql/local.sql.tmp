INSERT INTO `wp_postmeta` VALUES (5007,1013,'_observaciones','<strong>Documento que se obtiene:</strong>\n\nOtorgamiento de subsidio.\n\n<strong>Descripción del trámite:</strong>\n<ul>\n 	<li><a href=\"/wp-content/uploads/2025/02/SOLICITUD-subsidio-deportivo.pdf\">Descargar el formulario</a> de la web o solicitar una copia en la oficina de la Subsecretaría de Deportes.</li>\n 	<li>Completarlo y presentarlo en la Subsecretaría de Deportes.</li>\n 	<li>Verificar la aprobación de la solicitud.</li>\n 	<li>En caso de tratarse de una salida educativa debe acercar a la dirección de turismo, tercera edad y recreación la autorización de la autoridad escolar correspondiente.</li>\n</ul>\n<strong>¿Quién lo puede realizar?:</strong>\n\nDeportistas amateurs de San Miguel.');
