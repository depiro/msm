INSERT INTO `wp_postmeta` VALUES (5044,1015,'observaciones','DEBERÁN AJUSTARSE A REGLAMENTACIONES VIGENTES PARA EL RUBRO HABILITADO. NO OCASIONAR TRASTORNOS A TERCEROS.\nNO OBSTACULIZAR LA VÍA PÚBLICA.NO PRODUCIR RUIDOS MOLESTOS.\nATENTO A LO HABILITADO:\nNO PODRÁN COMERCIALIZAR BEBIDAS ALCOHÓLICAS DE NINGÚN TIPO (LEY PROVINCIAL Nº 11825/96).\nQUEDA PROHIBIDA LA VENTA DE BEBIDAS ALCOHÓLICAS A MENORES DE 18 (DIECIOCHO) AÑOS DE EDAD (LEY PROVINCIAL Nº11748/96).');
