INSERT INTO `wp_postmeta` VALUES (5419,1037,'observaciones','Descripción del trámite:\n\n 	Cargar los datos personales\n 	Cargar los datos laborales\n 	Cargar los datos del día, hora y lugar donde accede a servicio público\n\nDocumento que se obtiene:\n\nPlanilla con la información de lluvias y anegamientos en el partido de San Miguel.\n\n¿Quién lo puede realizar?:\n\nVecino que debido a la inundación y/o anegamiento de calles o rutas, se ve impedido de asistir a su lugar de trabajo y/o debe de llegar tarde a trabajar.\n\n¿Cómo recibo el resultado del trámite?:\n\nEn el momento se entrega una planilla con la información.\n\nCosto del trámite:\n\nSin costo');
