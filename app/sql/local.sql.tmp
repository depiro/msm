INSERT INTO `wp_postmeta` VALUES (5519,1041,'observaciones','DESCRIPCIÓN DEL TRÁMITE:\n\n 	Una vez que se cuente con la documentación necesaria, descargar SECRETARÍA DE PLANEAMIENTO Y DESARROLLO URBANO SUBSECRETARÍA DE AMBIENTE\n 	Completar el formulario y solicitar un turno de atención enviando un correo electrónico a la siguiente dirección: ambiente@msm.gov.ar.\n 	Presentarse en la oficina de la Subsecretaría de Ambiente en el día y horario indicado junto al formulario firmado y los originales y fotocopias de toda la documentación solicitada\n\n¿Quíen lo puede realizar?\n\nTitular, Apoderado o Gestor designado de Operadores de Aceite Vegetal Usado, que procesen AVU proveniente de Empresas Transportistas habilitadas por el Municipio de San Miguel para su recolección.\n\nDocumento que se obtiene\n\n: Constancia de Registro de Operadores de AVU Habilitado\n\nCosto del trámite:\n\nSin costo');
