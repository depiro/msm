INSERT INTO `wp_postmeta` VALUES (6619,1093,'observaciones','Descripción del trámite:\n\nPresentarse en ventanilla de la Dirección de Catastro.\n\nDocumento que se obtiene:\n\nCertificado de número de puerta.\n\n¿Quién lo puede realizar?\n\nContribuyente y profesionales en general.\n\n¿Cómo recibo el resultado del trámite?\n\nSe entrega en el momento el certificado de número en puerta.\n\nCosto del trámite:\n\nGratuito.');
