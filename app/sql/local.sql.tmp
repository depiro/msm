INSERT INTO `wp_postmeta` VALUES (7638,1247,'_requisitos','<ol>\n 	<li>Copia de DNI</li>\n 	<li>Copia de la constancia de opción (Monotributo)</li>\n 	<li>Un servicio a su nombre: (Luz, Gas, Teléfono, Impuesto, con el ultimo ticket pago)</li>\n</ol>\n<ol start=\"4\">\n 	<li>Cuil</li>\n 	<li>Credencial del Monotributo</li>\n 	<li>Ultimo ticket pago de Monotributo</li>\n 	<li>Constancia de la actividad en la cual se inscribieron y código de la actividad</li>\n</ol>');
