INSERT INTO `wp_postmeta` VALUES (6151,1075,'atiende_24hs','no');
INSERT INTO `wp_postmeta` VALUES (6152,1075,'_presentacion_del_tramite','Si la industria ya porta su Certificado de Aptitud Ambiental y se acerca el plazo del vencimiento, se deberá comenzar el trámite de renovación del mismo. Este trámite deberá iniciarse dentro de los sesenta (60) días corridos previos a que pierda vigencia el Certificado de Aptitud Ambiental (CAA) que se había otorgado, considerando que el establecimiento industrial no ha alterado los valores del nivel de complejidad ambiental con el que había sido calificado, y que no se han modificado sus principales procesos industriales asociados al rubro y actividad.');
INSERT INTO `wp_postmeta` VALUES (6153,1075,'_requisitos','<ol>\n 	<li>Redactar una nota dirigida a la Subsecretaría de Ambiente solicitando la renovación del Certificado de Aptitud Ambiental de la Industria.</li>\n 	<li>Presentar una Declaración Jurada ratificando la vigencia de las condiciones declaradas en oportunidad del otorgamiento del Certificado de Aptitud Ambiental anterior. De haber modificado algo que signifique un recambio en el puntaje de NCA, se deberá recategorizar la industria.</li>\n 	<li>Presentar una Auditoria Ambiental de la Industria en base a lo que se establece en el Anexo 6 del Decreto Reglamentario 1741/96, para poder corroborar que no se han modificado ni alterado los principales procesos productivos con los que había sido calificado previamente.</li>\n</ol>\nLa Auditoría deberá cumplir con los siguientes requisitos:\n<ul>\n 	<li>Líneas de producción - Diagramas de flujo.</li>\n 	<li>Caracterización y tratamiento de los residuos sólidos y semisólidos. Destino final.</li>\n 	<li>Caracterización y tratamiento de las emisiones gaseosas.</li>\n 	<li>Caracterización y tratamiento de los efluentes líquidos. Destino final.</li>\n 	<li>Condiciones y medio ambiente de trabajo.</li>\n 	<li>Conclusiones respecto del encuadre legal y el cumplimiento de la normativa ambiental específica para cada caso, por parte del establecimiento.</li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (6154,1075,'_duracion_del_tramite','Se presenta toda la documentación necesaria y luego pasa por una evaluación técnica municipal, que incluirá una o varias inspecciones. En menos de un mes el trámite estará finalizado.');
INSERT INTO `wp_postmeta` VALUES (6155,1075,'_vigencia_del_documento_obtenido','El Certificado de Aptitud Ambiental tiene una vigencia de 4 años.');
INSERT INTO `wp_postmeta` VALUES (6156,1075,'_respaldo_legal','<ul>\n 	<li><a href=\"http://www.opds.gba.gov.ar/sites/default/files/Ley%2011459.pdf\">Ley Provincial 11.459 de Radicación Industrial</a></li>\n 	<li><a href=\"http://www.opds.gba.gov.ar/sites/default/files/Decreto%20531-2019.pdf\">Decreto Reglamentario OPDS 531/19</a></li>\n 	<li><a href=\"https://normas.gba.gob.ar/documentos/xAm1N1fR.pdf\">Decreto 973/20</a></li>\n 	<li><a href=\"http://www.opds.gba.gov.ar/sites/default/files/LEY%2011720.pdf\">Ley Provincial 11.720 de Residuos Especiales</a></li>\n 	<li><a href=\"http://www.opds.gba.gov.ar/sites/default/files/RESOLUCION%20592%202000.pdf\">Resolución OPDS 592/00 – Disposición Transitoria de Residuos Especiales</a></li>\n 	<li><a href=\"http://www.opds.gba.gov.ar/sites/default/files/LEY%205965.pdf\">Ley 5.9 65 de Protección de Agua y Atmósfera</a></li>\n 	<li><a href=\"http://www.opds.gba.gov.ar/sites/default/files/Decreto%201074%2018.pdf\">Decreto Reglamentario 1074/18 (Licencia de Emisiones Gaseosas a la Atmósfera)</a></li>\n 	<li><a href=\"http://www.ada.gba.gov.ar/sites/default/files/2020-01/RSC-2019-41907175-GDEBA-ADA.pdf\">Resolución ADA 2222/19 (Prefactibilidad Hídrica, Aptitud de Obra, y Permisos )</a></li>\n</ul>');
INSERT INTO `wp_postmeta` VALUES (6157,1075,'_observaciones','El Certificado de Aptitud Ambiental es condición obligatoria para el funcionamiento y habilitación de los establecimientos industriales en toda la provincia de Buenos Aires.\n\n<strong>Descripción del trámite:</strong>\n\nPresentar la documentación solicitada en la Subsecretaría de Ambiente.\n\n<strong>Documento que se obtiene:</strong>\n\nCertificado de Aptitud Ambiental.\n\n<strong>¿Quién lo puede realizar?:</strong>\n\nIndustrias que deban renovar el CAA luego de haber trascurrido los 4 años de vigencia. (Conforme Decreto 531/19).\n\n<strong>Costo del trámite:</strong>\n\n<a href=\"/boletin-oficial/\">SEGÚN ORDENANZA TARIFARIA VIGENTE</a>');
INSERT INTO `wp_postmeta` VALUES (6158,1075,'_lugar_de_atencion','Subsecretaría de Ambiente, Domingo Faustino Sarmiento 1551, San Miguel.');
INSERT INTO `wp_postmeta` VALUES (6159,1075,'_horarios_de_atencion','Lunes a viernes 09 a 14hs con previo turno, solicitándolo al mail  <a href=\"mailto:industrias@msm.gov.ar\">industrias@msm.gov.ar</a> o por tel 6091-7100 int 6132/6133');
