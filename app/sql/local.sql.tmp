INSERT INTO `wp_postmeta` VALUES (7121,1116,'observaciones','Descripción del trámite:\n\nEl titular del inmueble deberá completar los formularios de solicitud de eximición y presentar la documentación requerida.\n\n¿Quién lo puede realizar?:\n\n 	Entidades educativas públicas, nacionales y municipales\n 	Jubilados y pensionados\n 	Cuerpo de bomberos voluntarios del partido\n 	Veteranos de guerra y excombatientes de Malvinas\n 	Discapacitados, sus padres y tutores\n 	Asociaciones o instituciones de bien público, instituciones religiosas de todos los cultos reconocidos por el Ministerio de Relaciones Exteriores y Culto de la Nación\n 	Madres y/o víctimas de desaparición forzada por las fuerzas armadas con anterioridad al año 1983.\n\nCosto del trámite:\n\nSEGÚN ORDENANZA TARIFARIA Y FISCAL VIGENTE');
