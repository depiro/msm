INSERT INTO `wp_postmeta` VALUES (6226,1078,'atiende_24hs','no');
INSERT INTO `wp_postmeta` VALUES (6227,1078,'_presentacion_del_tramite','<p class=\"bg-secretaria border-table\">La Oficina de Empleo, les ofrece a los empleadores un servicio de consultoría de Recursos Humanos (RRHH) que, sin costo económico alguno, se ocupa de gestionar las nuevas incorporaciones o convocatorias laborales que la organización requiera. El servicio ofrece:</p>\n\n<ol>\n 	<li>Armado y definición del perfil ocupacional requerido para el puesto de trabajo (determinación de competencias: formación, conocimientos, experiencia, cualidades personales, entre otros).</li>\n 	<li>Gestión y publicación de la búsqueda.</li>\n 	<li>Análisis de CV y entrevistas de preselección laboral.</li>\n 	<li>Selección de los perfiles laborales adecuados y derivación de estos al empleador, para que él realice la entrevista de selección final.</li>\n 	<li>Selección final por parte del empleador.</li>\n</ol>\nLas fechas y duración del proceso se acuerda con la parte contratante; y se puede repetir las veces que la misma considere necesaria. A partir de aquel proceso, el empleador se beneficia en tanto a la optimización de tiempos y el costo nulo, como así también en la aseveración de incorporar al perfil más adecuado al puesto');
INSERT INTO `wp_postmeta` VALUES (6228,1078,'_requisitos','<ol>\n 	<li>Estar registrado en la Agencia Federal de Ingresos Públicos (AFIP).</li>\n 	<li>Tener la empresa u organización radicada en San Miguel.</li>\n</ol>');
INSERT INTO `wp_postmeta` VALUES (6229,1078,'_duracion_del_tramite','<ol>\n 	<li>Completar el formulario de solicitud 30 minutos.</li>\n 	<li>El tiempo mínimo para la gestión completa del servicio (desde el inicio de la solicitud hasta la incorporación del candidato al puesto de trabajo) es de una semana</li>\n</ol>');
INSERT INTO `wp_postmeta` VALUES (6230,1078,'_vigencia_del_documento_obtenido','El servicio finaliza con la incorporación del candidato a la organización.');
INSERT INTO `wp_postmeta` VALUES (6231,1078,'_respaldo_legal','');
INSERT INTO `wp_postmeta` VALUES (6232,1078,'_observaciones','<strong>Descripción del trámite:</strong>\n<ol>\n 	<li>Si ya está definido el perfil ocupacional y el puesto laboral que requieren cubrir, se descarga <a href=\"https://www.msm.gov.ar/wp-content/uploads/2021/05/Formulario-de-Solicitud-de-Intermediaci%C3%B3n-Laboral-2020.pdf\">el formulario adjunto (solicitud de intermediación laboral)</a>, se completa y se envía a <a href=\"http://direcci%C3%B3n.empleo@msm.gov.ar/\">dirección.empleo@msm.gov.ar</a></li>\n 	<li>En menos de 24 hs, se establecerá la comunicación, vía mail y/o telefónicamente para continuar el proceso.</li>\n 	<li>Si tenes dificultades para definir el perfil ocupacional que se ajuste al puesto vacante o preferís simplemente que completemos el formulario juntos, llámanos por teléfono o mándanos un mail para concretar una cita. Conocer más de tu organización nos va a permitir definir mejor el perfil de la búsqueda y tener más éxito en la gestión de la misma.</li>\n</ol>\n<strong>Documento que se obtiene:</strong>\n\nInforme de la gestión de la búsqueda, con el análisis de los perfiles pre-seleccionados.\n\n<strong>¿Quién lo puede realizar?:</strong>\n\nComerciantes, Pymes e Industrias locales (potenciales empleadores).\n\n<strong>Costo del trámite:</strong>\n\nSin costo.\n\n&nbsp;');
INSERT INTO `wp_postmeta` VALUES (6233,1078,'_lugar_de_atencion','L. Alem y D.F Sarmiento. Solicitar cita previa - Tel. 6100-7100 INT: 30/31 E-mail: <a href=\"http://direcci%C3%B3n.empleo@msm.gov.ar/\">dirección.empleo@msm.gov.ar</a>');
INSERT INTO `wp_postmeta` VALUES (6234,1078,'_horarios_de_atencion','Lunes a viernes 08 a 16hs');
INSERT INTO `wp_postmeta` VALUES (6235,1078,'_edit_last','1');
