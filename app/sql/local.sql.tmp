INSERT INTO `wp_postmeta` VALUES (8112,1271,'_presentacion_del_tramite','Marco Jurídico que tiene como finalidad la obtención de la Escritura.');
INSERT INTO `wp_postmeta` VALUES (8113,1271,'_requisitos','<ol>\n 	<li>Boleto compra/venta</li>\n 	<li>N.I. de los titulares y el grupo familiar convivientes con los domicilios actualizados.</li>\n 	<li>U.I.L/ C.U.I.T. de los titulares</li>\n 	<li>Acta de matrimonio de los solicitantes (si son casados)</li>\n 	<li>Impuesto Municipal (Años correlativos)</li>\n 	<li>Impuesto Municipal ARBA (Años correlativos)</li>\n 	<li>Planos reglamentados de mensura/instalaciones</li>\n 	<li>Servicios de luz, gas, teléfono, boletos oficiales, etc. que demuestren posesión efectiva y permanente por 20 años como mínimo.</li>\n 	<li>No se debe poseer otro inmueble. El bien adquirido debe ser de vivienda única, familiar y permanente.</li>\n 	<li>Firma de convenio marco de la MSM.</li>\n</ol>\n(Original y copia)');
