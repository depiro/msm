INSERT INTO `wp_postmeta` VALUES (6033,1067,'_lugar_de_atencion','Los medios virtuales son: -  SEM San Miguel para sistema Android. -  SEM MOBILE para sistema iOS. -  Facebook Messenger para Android y iOS. -  Télegram para Android y iOS. - Página web del municipio <a href=\"/sem-2/\">Estacionamiento Medido</a> o <a href=\"https://sem.msm.gov.ar/\">https://sem.msm.gov.ar</a> El pago también puede ser en los <a href=\"/sem-2/\" target=\"_blank\" rel=\"noopener\">puntos de venta</a>');
