INSERT INTO `wp_postmeta` VALUES (6028,1067,'_requisitos','<ul>\n 	<li>Toda persona que desee utilizar estacionamiento medido.</li>\n 	<li><strong>Para pago virtual:</strong> Se abona mediante un usuario de SEM por una APP o la web del municipio.</li>\n 	<li><strong>Para pago puntual:</strong> Brindar Nro de patente y abonar en efectivo.</li>\n</ul>');
