{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "msm-theme/desplegable",
    "version": "1.0.0",
    "title": "Desplegable (Acordeón Azul)",
    "category": "theme",
    "icon": "arrow-down-alt2",
    "description": "Acordeón desplegable con cabecera azul institucional.",
    "supports": {
        "html": false,
        "align": [
            "wide",
            "full"
        ]
    },
    "textdomain": "msm-theme-2",
    "attributes": {
        "title": {
            "type": "string",
            "source": "text",
            "selector": "p"
        },
        "isOpen": {
            "type": "boolean",
            "default": false
        }
    },
    "editorScript": "file:./build/index.js"
}